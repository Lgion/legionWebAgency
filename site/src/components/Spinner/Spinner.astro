---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  color?: string;
  label?: string;
  className?: string;
}

const {
  size = 'md',
  color = 'var(--color-primary, #1a1a1a)',
  label = 'Chargement en cours...',
  className = '',
} = Astro.props;
---

<div class={`spinnerContainer spinnerContainer--${size} ${className}`} role="status">
  <progress class="spinner" aria-label={label}></progress>
  <span class="srOnly">{label}</span>
</div>

<style lang="scss" define:vars={{ spinnerColor: color }}>
  .spinnerContainer {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    &--sm {
      --spinner-size: 20px;
      --spinner-thickness: 2px;
    }

    &--md {
      --spinner-size: 32px;
      --spinner-thickness: 3px;
    }

    &--lg {
      --spinner-size: 48px;
      --spinner-thickness: 4px;
    }
  }

  .spinner {
    appearance: none;
    width: var(--spinner-size, 32px);
    height: var(--spinner-size, 32px);
    border-radius: 50%;
    border: var(--spinner-thickness, 3px) solid rgba(0, 0, 0, 0.1);
    border-top-color: var(--spinnerColor);
    background: transparent;
    animation: spin 0.8s linear infinite;

    // Masquage barres natives
    &::-webkit-progress-bar { display: none; }
    &::-webkit-progress-value { display: none; }
    &::-moz-progress-bar { display: none; }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .srOnly {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .spinner {
      animation-duration: 3s;
    }
  }
</style>
