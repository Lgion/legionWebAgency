---
interface Props {
  width?: string;
  height?: string;
  radius?: 'sm' | 'md' | 'full';
  className?: string;
}

const {
  width = '100%',
  height = '1.25rem',
  radius = 'md',
  className = '',
} = Astro.props;
---

<div
  class={`skeleton skeleton--radius-${radius} ${className}`}
  style={{ width, height }}
  aria-hidden="true"
></div>

<style lang="scss">
  .skeleton {
    background: linear-gradient(
      90deg,
      #f1f5f9 0%,
      #e2e8f0 50%,
      #f1f5f9 100%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite ease-in-out;

    &--radius-sm {
      border-radius: 4px;
    }

    &--radius-md {
      border-radius: 8px;
    }

    &--radius-full {
      border-radius: 9999px;
    }
  }

  @keyframes shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skeleton {
      animation: none;
      background: #e2e8f0;
    }
  }
</style>
