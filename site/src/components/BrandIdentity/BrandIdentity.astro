---
import './index.scss';

interface Props {
  name: string;
  tagline?: string;
  href?: string;
  ariaLabel?: string;
  logoSrc?: string;
  modifier?: 'default' | 'compact';
  className?: string;
}

const {
  name,
  tagline,
  href = '/',
  ariaLabel,
  logoSrc,
  modifier = 'default',
  className = '',
} = Astro.props;

const computedAriaLabel = ariaLabel || `Accueil ${name}${tagline ? ` — ${tagline}` : ''}`;
---

<a
  href={href}
  class={`brandIdentity --${modifier} ${className}`.trim()}
  aria-label={computedAriaLabel}
>
  <span class="brandIdentity__emblem" aria-hidden="true">
    <slot name="emblem">
      {logoSrc ? (
        <img src={logoSrc} alt="" width="26" height="26" loading="eager" />
      ) : (
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
      )}
    </slot>
  </span>

  <div class="brandIdentity__text">
    <span class="brandIdentity__name">{name}</span>
    {tagline && <span class="brandIdentity__tagline">{tagline}</span>}
  </div>
</a>
