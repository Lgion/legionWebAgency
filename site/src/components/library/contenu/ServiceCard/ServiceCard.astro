---
import { client } from '@/lib/client';

export interface ServiceItem {
  slug: string;
  name: string;
  category: string;
  price: number;
  priceFrom?: boolean;
  duration?: number;
  description: string;
}

interface Props {
  service: ServiceItem;
  className?: string;
}

const { service, className = '' } = Astro.props;
const formattedPrice = new Intl.NumberFormat(client.locale || 'fr', {
  style: 'currency',
  currency: client.currency || 'XOF',
  maximumFractionDigits: 0
}).format(service.price);
---

<article class={`serviceCard ${className}`} id={`service-${service.slug}`}>
  <div class="serviceCard__body">
    <div class="serviceCard__header">
      <span class="serviceCard__category">{service.category}</span>
      {service.duration && (
        <span class="serviceCard__duration">{service.duration} min</span>
      )}
    </div>

    <h3 class="serviceCard__title">{service.name}</h3>
    <p class="serviceCard__description">{service.description}</p>

    <div class="serviceCard__footer">
      <span class="serviceCard__price">
        {service.priceFrom && <small>À partir de </small>}
        <strong>{formattedPrice}</strong>
      </span>

      <!-- Vrai lien vers la page de détail (SEO), intercepté en modal par progress enhancement -->
      <a
        href={`/prestations/${service.slug}`}
        class="serviceCard__cta modalTrigger"
        data-slug={service.slug}
        data-title={service.name}
        data-price={formattedPrice}
        data-desc={service.description}
      >
        Détails
      </a>
    </div>
  </div>
</article>

<style lang="scss">
  .serviceCard {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-md, 8px);
    padding: 1.5rem;
    transition: transform var(--transition-fast, 150ms), box-shadow var(--transition-fast, 150ms);
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
      border-color: #cbd5e1;
    }

    &__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
      font-size: 0.8rem;
    }

    &__category {
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-accent, #2563eb);
    }

    &__duration {
      color: #64748b;
    }

    &__title {
      font-size: 1.25rem;
      font-weight: 700;
      margin: 0 0 0.5rem;
      color: var(--color-text-main, #0f172a);
    }

    &__description {
      color: #475569;
      font-size: 0.95rem;
      line-height: 1.5;
      margin: 0 0 1.25rem;
    }

    &__footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 1rem;
      border-top: 1px solid #f1f5f9;
    }

    &__price {
      font-size: 1.15rem;
      color: var(--color-text-main, #0f172a);

      small {
        font-size: 0.8rem;
        color: #64748b;
      }
    }

    &__cta {
      display: inline-flex;
      align-items: center;
      padding: 0.45rem 0.9rem;
      background: #f1f5f9;
      color: #0f172a;
      border-radius: var(--radius-sm, 4px);
      font-size: 0.875rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 150ms, color 150ms;

      &:hover {
        background: #0f172a;
        color: #ffffff;
      }
    }
  }
</style>
