---
import { client } from '@/lib/client';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const phoneClean = client.contact.phone.replace(/[^0-9+]/g, '');
const whatsappClean = client.contact.whatsapp.replace(/[^0-9]/g, '');
---

<header class={`appHeader ${className}`} id="mainHeader">
  <div class="appHeader__container">
    <a href="/" class="appHeader__brand" aria-label={`Accueil ${client.name}`}>
      {client.brand.logo ? (
        <img src={client.brand.logo} alt={client.name} class="appHeader__logo" width="140" height="40" />
      ) : (
        <span class="appHeader__name">{client.name}</span>
      )}
    </a>

    <nav class="appHeader__nav" aria-label="Navigation principale">
      <ul class="appHeader__navList">
        <li><a href="#prestations" class="appHeader__link">Prestations</a></li>
        {client.products && client.products.length > 0 && (
          <li><a href="#produits" class="appHeader__link">Produits</a></li>
        )}
        <li><a href="#horaires" class="appHeader__link">Horaires</a></li>
        <li><a href="#contact" class="appHeader__link">Contact</a></li>
      </ul>
    </nav>

    <div class="appHeader__actions">
      <a href={`https://wa.me/${whatsappClean}`} class="appHeader__cta" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
        </svg>
        <span>Réserver</span>
      </a>
    </div>
  </div>
</header>

<style lang="scss">
  .appHeader {
    position: sticky;
    top: 0;
    z-index: var(--z-header, 100);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border, #e2e8f0);
    transition: box-shadow var(--transition-fast, 150ms);

    &__container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0.75rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    &__brand {
      display: flex;
      align-items: center;
      text-decoration: none;
      font-weight: 700;
      font-size: 1.25rem;
      color: var(--color-text-main, #0f172a);
    }

    &__name {
      letter-spacing: -0.02em;
    }

    &__nav {
      display: none;

      @media (min-width: 768px) {
        display: block;
      }
    }

    &__navList {
      display: flex;
      gap: 1.75rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    &__link {
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--color-text-muted, #64748b);
      transition: color var(--transition-fast, 150ms);

      &:hover {
        color: var(--color-text-main, #0f172a);
      }
    }

    &__actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    &__cta {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: #25D366;
      color: white;
      border-radius: var(--radius-full, 9999px);
      font-size: 0.875rem;
      font-weight: 600;
      text-decoration: none;
      box-shadow: 0 2px 4px rgba(37, 211, 102, 0.2);
      transition: transform var(--transition-fast, 150ms), box-shadow var(--transition-fast, 150ms);

      &:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(37, 211, 102, 0.3);
      }
    }
  }
</style>
