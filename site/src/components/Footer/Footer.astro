---
import { client } from '@/lib/client';

interface Props {
  variant?: 'ticket' | 'carte-visite' | 'classique';
  className?: string;
}

const {
  variant = client.brand.footerVariant || 'carte-visite',
  className = '',
} = Astro.props;

const phoneClean = client.contact.phone.replace(/[^0-9+]/g, '');
const whatsappClean = client.contact.whatsapp.replace(/[^0-9]/g, '');
const addressQuery = encodeURIComponent(
  `${client.contact.address.street}, ${client.contact.address.district}, ${client.contact.address.city}`
);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${addressQuery}`;
---

<footer class={`appFooter appFooter--${variant} ${className}`} id="contact">
  <div class="appFooter__container">
    <div class="appFooter__card">
      <div class="appFooter__header">
        <span class="appFooter__badge" id="openingStatusBadge">
          <span class="appFooter__dot"></span>
          <span id="openingStatusText">Vérification horaires...</span>
        </span>
        <h2 class="appFooter__title">{client.name}</h2>
        <p class="appFooter__subtitle">{client.activity.pitch}</p>
      </div>

      <div class="appFooter__grid">
        <!-- Coordonnées directes -->
        <div class="appFooter__col">
          <h3 class="appFooter__heading">Contact & Réservation</h3>
          <ul class="appFooter__contactList">
            <li>
              <a href={`tel:${phoneClean}`} class="appFooter__contactLink">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
                </svg>
                <span>{client.contact.phone}</span>
              </a>
            </li>
            <li>
              <a href={`https://wa.me/${whatsappClean}`} class="appFooter__contactLink appFooter__contactLink--wa" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
                </svg>
                <span>WhatsApp : {client.contact.whatsapp}</span>
              </a>
            </li>
            {client.contact.email && (
              <li>
                <a href={`mailto:${client.contact.email}`} class="appFooter__contactLink">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                  <span>{client.contact.email}</span>
                </a>
              </li>
            )}
          </ul>
        </div>

        <!-- Horaires d'ouverture -->
        <div class="appFooter__col" id="horaires">
          <h3 class="appFooter__heading">Horaires d'Ouverture</h3>
          <ul class="appFooter__hoursList">
            {client.hours.map((schedule) => (
              <li class="appFooter__hoursItem">
                <span class="appFooter__days">
                  {schedule.days.join(', ')}
                </span>
                <span class="appFooter__time">
                  {schedule.opens ? `${schedule.opens} – ${schedule.closes}` : 'Fermé'}
                </span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Localisation & Accès -->
        <div class="appFooter__col">
          <h3 class="appFooter__heading">Adresse & Accès</h3>
          <address class="appFooter__address">
            <p>{client.contact.address.street}</p>
            <p>{client.contact.address.district}, {client.contact.address.city}</p>
            <p>{client.contact.address.country}</p>
          </address>
          <a href={mapsUrl} target="_blank" rel="noopener" class="appFooter__mapsBtn">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polygon points="3 11 22 2 13 21 11 13 3 11"/>
            </svg>
            <span>Ouvrir dans Google Maps / Waze</span>
          </a>
        </div>
      </div>

      <div class="appFooter__bottom">
        <p>&copy; {new Date().getFullYear()} {client.name}. Tous droits réservés.</p>
        <div class="appFooter__legal">
          <a href="/mentions-legales">Mentions légales</a>
          <span>•</span>
          <a href="/confidentialite">Confidentialité</a>
          <span>•</span>
          <a href="/web-agency-abidjan" title="Portfolio de l'agence web à Abidjan">Agence Web Abidjan</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script is:inline define:vars={{ hours: client.hours }}>
  // Calcul en direct de l'état Ouvert / Fermé
  function updateOpeningStatus() {
    const textEl = document.getElementById('openingStatusText');
    const badgeEl = document.getElementById('openingStatusBadge');
    if (!textEl || !badgeEl) return;

    const now = new Date();
    const dayMap = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'];
    const currentDay = dayMap[now.getDay()];
    const currentMinutes = now.getHours() * 60 + now.getMinutes();

    let isOpen = false;
    let nextInfo = '';

    for (const h of hours) {
      if (h.days.includes(currentDay)) {
        if (!h.opens || !h.closes) {
          isOpen = false;
          break;
        }
        const [openH, openM] = h.opens.split(':').map(Number);
        const [closeH, closeM] = h.closes.split(':').map(Number);
        const openMin = openH * 60 + openM;
        const closeMin = closeH * 60 + closeM;

        if (currentMinutes >= openMin && currentMinutes < closeMin) {
          isOpen = true;
          nextInfo = `Ferme à ${h.closes}`;
        } else if (currentMinutes < openMin) {
          nextInfo = `Ouvre à ${h.opens}`;
        } else {
          nextInfo = 'Fermé actuellement';
        }
        break;
      }
    }

    if (isOpen) {
      badgeEl.classList.add('appFooter__badge--open');
      badgeEl.classList.remove('appFooter__badge--closed');
      textEl.textContent = `Ouvert • ${nextInfo}`;
    } else {
      badgeEl.classList.add('appFooter__badge--closed');
      badgeEl.classList.remove('appFooter__badge--open');
      textEl.textContent = nextInfo || 'Fermé actuellement';
    }
  }

  updateOpeningStatus();
</script>

<style lang="scss">
  .appFooter {
    background: #0f172a;
    color: #f8fafc;
    padding: 3rem 1.25rem 2rem;

    &__container {
      max-width: 1100px;
      margin: 0 auto;
    }

    &__card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: var(--radius-lg, 16px);
      padding: 2.5rem 2rem;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
    }

    &__header {
      border-bottom: 1px solid #334155;
      padding-bottom: 1.5rem;
      margin-bottom: 2rem;
      text-align: center;
    }

    &__badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-full, 9999px);
      font-size: 0.85rem;
      font-weight: 600;
      background: rgba(255, 255, 255, 0.08);
      color: #94a3b8;
      margin-bottom: 1rem;

      &--open {
        background: rgba(34, 197, 94, 0.15);
        color: #4ade80;

        .appFooter__dot {
          background-color: #22c55e;
          box-shadow: 0 0 8px #22c55e;
        }
      }

      &--closed {
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;

        .appFooter__dot {
          background-color: #ef4444;
        }
      }
    }

    &__dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #64748b;
    }

    &__title {
      font-size: 2rem;
      color: #ffffff;
      margin: 0 0 0.5rem;
    }

    &__subtitle {
      color: #94a3b8;
      margin: 0;
      font-size: 1.05rem;
    }

    &__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;

      @media (min-width: 768px) {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    &__heading {
      font-size: 1.1rem;
      color: #ffffff;
      margin: 0 0 1rem;
      border-left: 3px solid var(--color-accent, #3b82f6);
      padding-left: 0.5rem;
    }

    &__contactList, &__hoursList {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    &__contactLink {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: #cbd5e1;
      padding: 0.5rem 0;
      transition: color 150ms;

      &:hover {
        color: #ffffff;
      }

      &--wa:hover {
        color: #4ade80;
      }
    }

    &__hoursItem {
      display: flex;
      justify-content: space-between;
      padding: 0.4rem 0;
      border-bottom: 1px dashed #334155;
      font-size: 0.95rem;
      color: #cbd5e1;
    }

    &__address {
      font-style: normal;
      color: #cbd5e1;
      line-height: 1.5;
      margin-bottom: 1rem;

      p {
        margin: 0.2rem 0;
      }
    }

    &__mapsBtn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1rem;
      background: #334155;
      color: #ffffff;
      border-radius: var(--radius-md, 8px);
      font-size: 0.875rem;
      font-weight: 500;
      transition: background 150ms;

      &:hover {
        background: #475569;
      }
    }

    &__bottom {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid #334155;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 1rem;
      font-size: 0.85rem;
      color: #64748b;

      p {
        margin: 0;
      }
    }

    &__legal {
      display: flex;
      gap: 0.75rem;

      a {
        color: #94a3b8;
        &:hover { color: #ffffff; }
      }
    }
  }
</style>
