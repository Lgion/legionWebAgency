---
import Layout from '../layouts/Layout.astro';
import Accordion from '../components/Accordion/Accordion.astro';
import Spinner from '../components/Spinner/Spinner.astro';
import Skeleton from '../components/Skeleton/Skeleton.astro';
import ServiceCard from '../components/ServiceCard/ServiceCard.astro';
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer/Footer.astro';
import FabContact from '../components/FabContact/FabContact.astro';
import FabTools from '../components/FabTools/FabTools.astro';
import CartDrawer from '../components/Cart/CartDrawer.astro';
import WaveModal from '../components/WaveModal/WaveModal.astro';
import ActionHub from '../components/ActionHub/ActionHub.astro';
import SeasonalShowcase from '../components/SeasonalShowcase/SeasonalShowcase.astro';

const demoItems = [
  {
    title: "1. Variantes d'Accordion BEM LegionUI",
    content: "Démontre le découplage SCSS sans classes utilitaires dans le template. Deux modificateurs : --default et --chrome."
  },
  {
    title: "2. Structure sémantique HTML5 native",
    content: "Utilise <details> et <summary> pour une indexation SEO sans JavaScript requis pour l'affichage de base."
  }
];

const demoService = {
  slug: "soin-visage-eclat",
  name: "Soin Visage Éclat Bio",
  category: "Esthétique & Spa",
  price: 25000,
  duration: 45,
  description: "Nettoyage en profondeur, gommage aux extraits naturels et masque hydratant pour un teint lumineux instantané."
};
---

<Layout title="Catalogue Visuel des Composants — WebAgency" noindex={true}>
  <div class="cataloguePage">
    <div class="catalogueBar">
      <div class="catalogueBar__container">
        <h1>🎨 Showcase des Composants (WebAgency Boilerplate)</h1>
        <p>Outil de développement et de démonstration commerciale pour les prospects.</p>
      </div>
    </div>

    <div class="catalogueContent">
      <!-- Section Feedback : Spinners et Skeletons -->
      <section class="demoSection">
        <h2 class="demoSection__title">1. Feedback : Spinners CSS légers & Skeletons</h2>
        <div class="demoGrid">
          <div class="demoCard">
            <h3>Spinners (CSS pur, sans GIF/Lottie)</h3>
            <div class="demoCard__row">
              <div><Spinner size="sm" /> <small>sm (20px)</small></div>
              <div><Spinner size="md" /> <small>md (32px)</small></div>
              <div><Spinner size="lg" color="#2563eb" /> <small>lg (48px)</small></div>
            </div>
          </div>
          <div class="demoCard">
            <h3>Skeletons (Zéro CLS)</h3>
            <div class="demoCard__col">
              <Skeleton width="60%" height="1.5rem" radius="sm" />
              <Skeleton width="100%" height="1rem" radius="md" />
              <Skeleton width="80%" height="1rem" radius="md" />
              <Skeleton width="40px" height="40px" radius="full" />
            </div>
          </div>
        </div>
      </section>

      <!-- Section Accordion : Variantes -->
      <section class="demoSection">
        <h2 class="demoSection__title">2. Contenu : Accordion LegionUI (`--default` vs `--chrome`)</h2>
        <div class="demoGrid">
          <div class="demoCard">
            <h3>Variante `--default` (Cartouche BEM standard)</h3>
            <Accordion items={demoItems} modifier="default" id="accordionDemoDefault" />
          </div>
          <div class="demoCard">
            <h3>Variante `--chrome` (Style épuré Material/Google)</h3>
            <Accordion items={demoItems} modifier="chrome" id="accordionDemoChrome" />
          </div>
        </div>
      </section>

      <!-- Section Prestations : ServiceCard & Panier -->
      <section class="demoSection">
        <h2 class="demoSection__title">3. E-commerce & Paiement : ServiceCard, CartDrawer & WaveModal</h2>
        <div style="max-width: 360px; margin-bottom: 1.5rem;">
          <ServiceCard service={demoService} />
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
          <button type="button" class="demoCartOpenBtn" id="demoOpenCartBtn">
            🛒 Tester le CartDrawer (3 étapes)
          </button>
          <button type="button" class="demoCartOpenBtn openWaveModalTrigger" style="background: #1898e8;">
            💳 Tester la Modale Paiement Wave QR
          </button>
        </div>
      </section>

      <!-- Section ActionHub -->
      <section class="demoSection">
        <h2 class="demoSection__title">4. Conversion : ActionHub (Démarches Express & Simulateur Devis)</h2>
        <ActionHub />
      </section>

      <!-- Section SeasonalShowcase -->
      <section class="demoSection">
        <h2 class="demoSection__title">5. Commerce : SeasonalShowcase (Vitrine Saisonnière)</h2>
        <SeasonalShowcase />
      </section>
    </div>
  </div>

  <WaveModal />
  <CartDrawer />
  <FabContact />
  <FabTools />
</Layout>

<script>
  import { updateStorage } from '@/lib/storage';

  document.getElementById('demoOpenCartBtn')?.addEventListener('click', () => {
    // Ajoute un article démo s'il n'y en a pas
    updateStorage(prev => {
      if (prev.cart.length === 0) {
        prev.cart.push({
          id: 'soin-visage-eclat',
          name: 'Soin Visage Éclat Bio',
          price: 25000,
          quantity: 1
        });
      }
      return prev;
    });
    window.dispatchEvent(new CustomEvent('cart:open'));
  });
</script>

<style lang="scss">
  .cataloguePage {
    background: #f1f5f9;
    min-height: 100vh;
    padding-bottom: 5rem;
  }

  .catalogueBar {
    background: #0f172a;
    color: #ffffff;
    padding: 2.5rem 1.25rem;

    &__container {
      max-width: 1200px;
      margin: 0 auto;

      h1 {
        margin: 0 0 0.5rem;
        font-size: 1.75rem;
      }

      p {
        margin: 0;
        color: #94a3b8;
      }
    }
  }

  .catalogueContent {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .demoSection {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-lg, 16px);
    padding: 2rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);

    &__title {
      font-size: 1.35rem;
      color: #0f172a;
      margin: 0 0 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 2px solid #f1f5f9;
    }
  }

  .demoGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .demoCard {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-md, 8px);
    padding: 1.5rem;

    h3 {
      font-size: 1rem;
      color: #334155;
      margin: 0 0 1rem;
    }

    &__row {
      display: flex;
      align-items: center;
      gap: 2rem;

      div {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
      }
    }

    &__col {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  .demoCartOpenBtn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: #2563eb;
    color: white;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-size: 0.95rem;
    transition: transform 150ms;

    &:hover {
      transform: translateY(-2px);
    }
  }
</style>
