---
import Layout from '../layouts/Layout.astro';
import CartDrawer from '../components/Cart/CartDrawer.astro';
import BrandIdentity from '../components/BrandIdentity/BrandIdentity.astro';
import NavMenu from '../components/NavMenu/NavMenu.astro';
import StatusBadge from '../components/StatusBadge/StatusBadge.astro';
import ActionGroup from '../components/ActionGroup/ActionGroup.astro';
import { agencyData } from '../data/agencyData';

const canonicalURL = new URL('/web-agency-abidjan', Astro.site || 'https://localhost:4321');
const whatsappClean = agencyData.contact.whatsapp.replace(/[^0-9]/g, '');
const phoneClean = agencyData.contact.phone.replace(/[^0-9+]/g, '');
const addressQuery = encodeURIComponent(
  `${agencyData.contact.address.street}, ${agencyData.contact.address.district}, ${agencyData.contact.address.city}, ${agencyData.contact.address.country}`
);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${addressQuery}`;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: agencyData.name,
  alternateName: agencyData.brandName,
  description: agencyData.shortDescription,
  url: canonicalURL.toString(),
  telephone: agencyData.contact.phone,
  email: agencyData.contact.email,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: agencyData.contact.address.street,
    addressLocality: agencyData.contact.address.district,
    addressRegion: agencyData.contact.address.city,
    addressCountry: agencyData.contact.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: agencyData.contact.geo.lat,
    longitude: agencyData.contact.geo.lng,
  },
  sameAs: [
    agencyData.contact.socials.linkedin,
    agencyData.contact.socials.instagram,
    agencyData.contact.socials.facebook,
    agencyData.contact.socials.twitter,
    agencyData.contact.socials.github,
  ]
};
---

<Layout
  title="WebAgency Abidjan — Création de Sites Web B2C & E-Commerce à Abidjan"
  description="Agence web à Abidjan experte en sites B2C ultra-rapides pour commerces de proximité, salons, maquis et PME. Vitesse < 1s, WhatsApp 1-clic et paiement Wave intégré."
  image="/images/agency/agency_showcase.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <div class="agencyPortfolio" id="agencyPortfolio">
    <!-- BARRE D'ADMINISTRATION IN-SITU (VISIBLE SI RÔLE ADMIN ACTIF) -->
    <div class="agencyAdminBar" id="agencyAdminBar" style="display: none;">
      <div class="agencyAdminBar__container">
        <div class="agencyAdminBar__roleInfo">
          <span class="agencyAdminBar__badge">👑 Rôle Admin Actif</span>
          <span class="agencyAdminBar__hint">Édition de texte directe sur la page</span>
        </div>

        <div class="agencyAdminBar__controls">
          <label class="agencyAdminBar__toggle">
            <input type="checkbox" id="toggleInSituEdit" />
            <span>Mode Édition [ON/OFF]</span>
          </label>
          <button type="button" class="agencyAdminBar__saveBtn" id="saveInSituChangesBtn" style="display: none;">
            💾 Enregistrer Textes
          </button>
          <button type="button" class="agencyAdminBar__resetBtn" id="resetInSituChangesBtn">
            ↺ Réinitialiser
          </button>
          <a href="/admin-agency" class="agencyAdminBar__portalBtn">
            📊 Tableau de Bord
          </a>
          <button type="button" class="agencyAdminBar__exitBtn" id="exitAdminModeBtn">
            Quitter
          </button>
        </div>
      </div>
    </div>

    <!-- 1. STICKY HEADER AVEC COMPOSANTS LEGIONUI -->
    <header class="agencyHeader" id="agencyHeader">
      <div class="agencyHeader__container">
        <!-- Composant 1 : BrandIdentity (Identité visuelle & Logo) -->
        <BrandIdentity
          name={agencyData.brandName}
          tagline="Abidjan • Cocody"
          href="/web-agency-abidjan"
        />

        <!-- Composant 2 : StatusBadge (Indicateur disponibilité temps réel) -->
        <StatusBadge
          label="Disponible pour vos projets"
          status="online"
          pulse={true}
          className="agencyHeader__statusBadge"
        />

        <!-- Composant 3 : NavMenu (Navigation sémantique & a11y) -->
        <NavMenu
          items={[
            { label: 'Notre Métier', href: '#metier' },
            { label: 'Packs & Services', href: '#services' },
            { label: 'Réalisations', href: '#realisations' },
            { label: 'Simulateur Devis', isButton: true, triggerClass: 'openSimulatorTrigger' },
            { label: 'Paiement Wave', isButton: true, triggerClass: 'openWaveModalTrigger', dataAttrs: { 'data-amount': '50000' } },
            { label: 'Contact', href: '#contact' },
          ]}
          ariaLabel="Navigation principale de l'agence"
        />

        <!-- Composant 4 : ActionGroup (Micro-actions directes & conversion) -->
        <ActionGroup>
          <!-- BOUTON WAVE QR (ICON-ONLY SANS TEXTE, GRAND ET VISIBLE) -->
          <button
            type="button"
            class="actionGroup__btn --wave openWaveModalTrigger"
            data-amount="50000"
            aria-label="Payer un acompte via Wave QR Code"
            title="Paiement par Wave QR Code"
          >
            <img src="/wave.png" style="width:50px;max-width:unset;" />
          </button>

          <!-- BOUTON PANIER (AVEC BADGE ET SVG) -->
          <button
            type="button"
            id="headerCartBtn"
            class="actionGroup__btn --cart"
            aria-label="Ouvrir le panier"
            title="Votre panier"
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"></path>
            </svg>
            <span id="headerCartBadge" class="actionGroup__badge" data-type="cart">0</span>
          </button>

          <!-- BOUTON WHATSAPP DIRECT (ICON-ONLY SANS TEXTE, GRAND ET VISIBLE) -->
          <a
            href={`https://wa.me/${whatsappClean}?text=${encodeURIComponent("Bonjour WebAgency Abidjan, je souhaite créer un site web pour mon commerce.")}`}
            class="actionGroup__btn --whatsapp"
            target="_blank"
            rel="noopener"
            aria-label="Contacter l'agence sur WhatsApp"
            title="Discussion WhatsApp directe"
          >
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
            </svg>
          </a>

          <!-- LIEN PORTAIL ADMIN / RÔLES -->
          <a
            href="/admin-agency"
            class="actionGroup__btn --admin"
            title="Espace Administration & Partenaires"
            aria-label="Accès espace administration"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
          </a>
        </ActionGroup>
      </div>
    </header>

    <main>
      <!-- 2. HERO SECTION -->
      <section class="agencyHero" id="accueil">
        <div class="agencyHero__container">
          <div class="agencyHero__grid">
            <div class="agencyHero__content">
              <div class="agencyHero__badgeGroup">
                <span class="agencyHero__badge --cyan">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                  </svg>
                  <span>Sites Web B2C Ultra-Rapides</span>
                </span>
                <span class="agencyHero__badge --emerald">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                    <line x1="12" y1="18" x2="12.01" y2="18"></line>
                  </svg>
                  <span>100% Mobile 3G/4G Côte d'Ivoire</span>
                </span>
              </div>

              <h1 class="agencyHero__title editableText" data-text-id="hero_title">
                Le web à forte conversion pour les <span class="agencyHero__titleHighlight">commerces de proximité</span> à Abidjan
              </h1>

              <p class="agencyHero__pitch editableText" data-text-id="hero_pitch">{agencyData.heroPitch}</p>

              <div class="agencyHero__actions">
                <a
                  href={`https://wa.me/${whatsappClean}?text=${encodeURIComponent("Bonjour WebAgency Abidjan, j'aimerais échanger sur la création de mon site web.")}`}
                  class="agencyHero__btnPrimary"
                  target="_blank"
                  rel="noopener"
                >
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
                  </svg>
                  <span>Discuter de mon projet</span>
                </a>

                <button type="button" class="agencyHero__btnSecondary openSimulatorTrigger">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                    <line x1="8" y1="6" x2="16" y2="6"></line>
                    <line x1="16" y1="14" x2="16" y2="18"></line>
                    <path d="M16 10h.01"></path>
                    <path d="M12 10h.01"></path>
                    <path d="M8 10h.01"></path>
                    <path d="M12 14h.01"></path>
                    <path d="M8 14h.01"></path>
                    <path d="M12 18h.01"></path>
                    <path d="M8 18h.01"></path>
                  </svg>
                  <span>Calculer mon devis</span>
                </button>

                <button type="button" class="agencyHero__btnWave openWaveModalTrigger" data-amount="50000">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" fill="#1898E8"/>
                    <path d="M8 12l3 3 5-5" stroke="#fff" stroke-width="2" fill="none"/>
                  </svg>
                  <span>Payer Acompte Wave</span>
                </button>
              </div>

              <!-- Stats bar -->
              <div class="agencyHero__stats">
                {agencyData.stats.map((stat) => (
                  <div class="agencyHero__statCard">
                    <span class="agencyHero__statVal">{stat.value}</span>
                    <span class="agencyHero__statLabel">{stat.label}</span>
                    <span class="agencyHero__statSub">{stat.sub}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Hero Visual Banner -->
            <div class="agencyHero__visual">
              <div class="agencyHero__visualFrame">
                <img
                  src="/images/agency/agency_showcase.jpg"
                  alt="Portfolio de sites web B2C créés à Abidjan sur ordinateurs et smartphones"
                  width="1280"
                  height="720"
                  class="agencyHero__image"
                  loading="eager"
                />
                <div class="agencyHero__visualOverlay">
                  <span class="agencyHero__visualTag">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    <span>Livrables réels déployés à Abidjan</span>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- TRANSITION HERO -> VALUES (VIBRANT EMERALD / GOLD / WAVE BLUE) -->
      <div class="agencyWaveDivider" aria-hidden="true">
        <svg class="agencyWaveDivider__svg" viewBox="0 0 1440 100" preserveAspectRatio="none">
          <defs>
            <linearGradient id="vividWave1" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#10B981" />
              <stop offset="35%" stop-color="#D4AF37" />
              <stop offset="70%" stop-color="#F59E0B" />
              <stop offset="100%" stop-color="#1898E8" />
            </linearGradient>
          </defs>
          <path class="agencyWaveDivider__wave --layer1" d="M0,32L48,42.7C96,53,192,75,288,80C384,85,480,75,576,58.7C672,43,768,21,864,21.3C960,21,1056,43,1152,53.3C1248,64,1344,64,1392,64L1440,64L1440,100L0,100Z" fill="url(#vividWave1)" opacity="0.85"/>
          <path class="agencyWaveDivider__wave --layer2" d="M0,50L48,56C96,62,192,72,288,68C384,64,480,48,576,44C672,40,768,48,864,58C960,68,1056,76,1152,72C1248,68,1344,48,1392,38L1440,28L1440,100L0,100Z" fill="#0B1120"/>
          <path class="agencyWaveDivider__crest" d="M0,50L48,56C96,62,192,72,288,68C384,64,480,48,576,44C672,40,768,48,864,58C960,68,1056,76,1152,72C1248,68,1344,48,1392,38L1440,28" fill="none" stroke="url(#vividWave1)" stroke-width="2.5" opacity="0.95"/>
        </svg>
      </div>

      <!-- 3. NOTRE MÉTIER & VALEURS CLÉS (AVEC PARALLAX SUBTIL DE FOND) -->
      <section class="agencyValues" id="metier" data-parallax-block="true">
        <div class="agencySectionParallaxBg --metier" aria-hidden="true"></div>
        <div class="agencySectionParallaxFloat --metier" aria-hidden="true"></div>
        <div class="agencyValues__container">
          <header class="agencySectionHeader">
            <span class="agencySectionHeader__eyebrow">Notre Philosophie & Coeur de Métier</span>
            <h2 class="agencySectionHeader__title editableText" data-text-id="values_title">Pourquoi les sites classiques échouent à Abidjan</h2>
            <p class="agencySectionHeader__subtitle editableText" data-text-id="values_sub">
              90% des sites créés sous WordPress ou constructeurs lourds perdent la moitié de leurs visiteurs ivoiriens à cause de temps de chargement trop longs et d'un manque de call-to-action adaptés aux réalités locales.
            </p>
          </header>

          <!-- Comparatif Choc -->
          <div class="agencyComparison">
            <article class="agencyComparison__card --old">
              <div class="agencyComparison__header">
                <span class="agencyComparison__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                  </svg>
                </span>
                <h3>Sites d'Agence Traditionnels</h3>
              </div>
              <ul class="agencyComparison__list">
                <li>Temps de chargement de 4 à 8 secondes sur réseau 3G/4G</li>
                <li>Formulaires email complexes que les clients locaux n'utilisent jamais</li>
                <li>Frais récurrents d'hébergement et de maintenance (20 000 à 50 000 F/mois)</li>
                <li>Pannes de plugins, lenteurs et bugs après mises à jour</li>
                <li>Impossible de modifier un simple prix sans payer un technicien</li>
              </ul>
            </article>

            <article class="agencyComparison__card --new">
              <div class="agencyComparison__header">
                <span class="agencyComparison__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="9 12 11 14 15 10"></polyline>
                  </svg>
                </span>
                <h3>La Méthode WebAgency Abidjan</h3>
              </div>
              <ul class="agencyComparison__list">
                <li>Ouverture instantanée en moins d'1 seconde (Astro + BEM SCSS pur)</li>
                <li>Prise de contact 100% WhatsApp & Appel 1-clic intégrés</li>
                <li>Zéro abonnement obligatoire : hébergement CDN mondial gratuit</li>
                <li>Paiement direct Wave QR Code & Mobile Money sans carte bancaire</li>
                <li>Espace d'administration simple pour changer ses prix depuis smartphone</li>
              </ul>
            </article>
          </div>

          <!-- 6 Piliers d'Excellence -->
          <div class="agencyValues__grid">
            {agencyData.coreValues.map((val) => (
              <article class="agencyValueCard">
                <div class="agencyValueCard__top">
                  <span class="agencyValueCard__icon" aria-hidden="true">
                    {val.iconSvg === 'lightning' && (
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                      </svg>
                    )}
                    {val.iconSvg === 'target' && (
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <circle cx="12" cy="12" r="6"></circle>
                        <circle cx="12" cy="12" r="2"></circle>
                      </svg>
                    )}
                    {val.iconSvg === 'mobile' && (
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="5" y="2" width="14" height="20" rx="2"></rect>
                        <line x1="12" y1="18" x2="12.01" y2="18"></line>
                      </svg>
                    )}
                    {val.iconSvg === 'shield' && (
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                      </svg>
                    )}
                    {val.iconSvg === 'dashboard' && (
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="9"></rect>
                        <rect x="14" y="3" width="7" height="5"></rect>
                        <rect x="14" y="12" width="7" height="9"></rect>
                        <rect x="3" y="16" width="7" height="5"></rect>
                      </svg>
                    )}
                    {val.iconSvg === 'map-pin' && (
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                      </svg>
                    )}
                  </span>
                  <span class="agencyValueCard__badge">{val.highlight}</span>
                </div>
                <h3 class="agencyValueCard__title">{val.title}</h3>
                <p class="agencyValueCard__desc">{val.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- TRANSITION VALUES -> REALISATIONS (VIBRANT WAVE BLUE / EMERALD / GOLD) -->
      <div class="agencyWaveDivider --inverted" aria-hidden="true">
        <svg class="agencyWaveDivider__svg" viewBox="0 0 1440 100" preserveAspectRatio="none">
          <defs>
            <linearGradient id="vividWave2" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#1898E8" />
              <stop offset="35%" stop-color="#10B981" />
              <stop offset="70%" stop-color="#F59E0B" />
              <stop offset="100%" stop-color="#D4AF37" />
            </linearGradient>
          </defs>
          <path class="agencyWaveDivider__wave --layer1" d="M0,32L48,42.7C96,53,192,75,288,80C384,85,480,75,576,58.7C672,43,768,21,864,21.3C960,21,1056,43,1152,53.3C1248,64,1344,64,1392,64L1440,64L1440,100L0,100Z" fill="url(#vividWave2)" opacity="0.85"/>
          <path class="agencyWaveDivider__wave --layer2" d="M0,50L48,56C96,62,192,72,288,68C384,64,480,48,576,44C672,40,768,48,864,58C960,68,1056,76,1152,72C1248,68,1344,48,1392,38L1440,28L1440,100L0,100Z" fill="#080C16"/>
          <path class="agencyWaveDivider__crest" d="M0,50L48,56C96,62,192,72,288,68C384,64,480,48,576,44C672,40,768,48,864,58C960,68,1056,76,1152,72C1248,68,1344,48,1392,38L1440,28" fill="none" stroke="url(#vividWave2)" stroke-width="2.5" opacity="0.95"/>
        </svg>
      </div>

      <!-- 4. RÉALISATIONS CLIENTS (PORTFOLIO PROJETS AVEC PARALLAX SUBTIL DE FOND) -->
      <section class="agencyProjects" id="realisations" data-parallax-block="true">
        <div class="agencySectionParallaxBg --projects" aria-hidden="true"></div>
        <div class="agencySectionParallaxFloat --projects" aria-hidden="true"></div>
        <div class="agencyProjects__container">
          <header class="agencySectionHeader">
            <span class="agencySectionHeader__eyebrow">Nos Réalisations Concrètes</span>
            <h2 class="agencySectionHeader__title editableText" data-text-id="projects_title">Projets Déployés & En Cours de Livraison</h2>
            <p class="agencySectionHeader__subtitle editableText" data-text-id="projects_sub">
              Découvrez les sites créés pour nos clients commerçants et PME à Abidjan. Chaque livrable embarque nos composants standards : sticky header, boutons d'action rapide fixes, et paiement Wave QR.
            </p>
          </header>

          <!-- Filtres interactifs par catégorie -->
          <div class="agencyProjects__filterBar" role="tablist" aria-label="Filtrer les réalisations">
            <button type="button" class="agencyFilterBtn --active" data-filter="all" role="tab" aria-selected="true">
              <span>Tous les projets ({agencyData.projects.length})</span>
            </button>
            <button type="button" class="agencyFilterBtn" data-filter="Beauté" role="tab" aria-selected="false">
              <span>Beauté & Soins (3)</span>
            </button>
            <button type="button" class="agencyFilterBtn" data-filter="Multiservices" role="tab" aria-selected="false">
              <span>Multiservices & Studio (1)</span>
            </button>
