    border-radius: var(--ag-radius-md);
    overflow: hidden;

    &[open] {
      border-color: rgba(212, 175, 55, 0.45);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);

      .agencyFaqItem__chevron { transform: rotate(180deg); color: var(--ag-gold); }
      .agencyFaqItem__num {
        background: linear-gradient(135deg, var(--ag-gold) 0%, var(--ag-amber) 100%);
        color: #0A0E17;
        border-color: transparent;
      }
    }

    &__summary {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.25rem 1.5rem;
      cursor: pointer;
      list-style: none;

      &::-webkit-details-marker { display: none; }
    }

    &__num {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: rgba(212, 175, 55, 0.12);
      border: 1px solid rgba(212, 175, 55, 0.25);
      color: var(--ag-gold);
      font-size: 0.85rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background 0.2s ease, color 0.2s ease;
    }

    &__question {
      font-size: 1.05rem;
      font-weight: 800;
      color: #ffffff;
      flex: 1;
    }

    &__chevron {
      color: var(--ag-text-muted);
      transition: transform 0.2s ease;
      display: flex;
      align-items: center;
    }

    &__panel {
      padding: 0 1.5rem 1.5rem 4.5rem;
      font-size: 0.95rem;
      color: var(--ag-text-muted);
      line-height: 1.6;

      p { margin: 0; }
    }
  }

  // 8. FOOTER D'AGENCE OFFICIEL PLEINE LARGEUR (AVEC ARRIÈRE-PLAN PANORAMA URBAIN BD ANIME & PARALLAX)
  .agencyFooter {
    width: 100%;
    background: #04060A;
    border-top: 2px solid rgba(212, 175, 55, 0.35);
    position: relative;
    overflow: hidden;
    color: var(--ag-text);
    margin: 0;
    padding: 0;

    &__bg {
      position: absolute;
      top: -25%;
      bottom: -25%;
      left: -2%;
      right: -2%;
      background-image:
        linear-gradient(180deg,
          rgba(4, 6, 10, 0.45) 0%,
          rgba(4, 6, 10, 0.15) 20%,
          rgba(4, 6, 10, 0.40) 55%,
          rgba(4, 6, 10, 0.92) 100%),
        url('/images/agency/footer_abidjan_comic.jpg');
      background-size: cover;
      background-position: center 30%;
      will-change: transform;
      pointer-events: none;
      z-index: 0;
      opacity: 0.94;
      transition: transform 0.05s linear;
    }
  }

  // PALIER 1 : PRE-FOOTER CTA BANDEAU PLEINE LARGEUR
  .agencyFooterPreCta {
    position: relative;
    z-index: 1;
    width: 100%;
    background: rgba(6, 10, 18, 0.62);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3.5rem 1.5rem;

    &__inner {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
    }

    &__lead {
      max-width: 640px;
    }

    &__badge {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ag-gold);
      background: rgba(212, 175, 55, 0.1);
      border: 1px solid rgba(212, 175, 55, 0.25);
      padding: 0.35rem 0.85rem;
      border-radius: var(--ag-radius-full);
      margin-bottom: 0.75rem;
    }

    &__title {
      font-size: 1.85rem;
      font-weight: 900;
      letter-spacing: -0.02em;
      color: #ffffff;
      margin: 0 0 0.5rem 0;
      line-height: 1.25;

      @media (min-width: 768px) {
        font-size: 2.2rem;
      }
    }

    &__text {
      font-size: 0.95rem;
      color: var(--ag-text-muted);
      line-height: 1.55;
      margin: 0;
    }

    &__actions {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      flex-wrap: wrap;
    }
  }

  .agencyFooterPreCtaBtn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.35rem;
    border-radius: var(--ag-radius-full);
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);

    &.--whatsapp {
      background: #10B981;
      color: #042416;
      border: 1px solid #10B981;
      box-shadow: 0 6px 18px -4px rgba(16, 185, 129, 0.4);

      &:hover {
        transform: translateY(-2px);
        background: #059669;
        color: #ffffff;
      }
    }

    &.--wave {
      background: rgba(24, 152, 232, 0.12);
      color: #ffffff;
      border: 1px solid rgba(24, 152, 232, 0.4);

      &:hover {
        transform: translateY(-2px);
        background: rgba(24, 152, 232, 0.22);
        border-color: #1898E8;
      }
    }

    &.--phone {
      background: rgba(255, 255, 255, 0.05);
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.15);

      &:hover {
        transform: translateY(-2px);
        background: rgba(212, 175, 55, 0.12);
        border-color: var(--ag-gold);
        color: #FDE68A;
      }
    }
  }

  // PALIER 2 : CORPS MULTI-COLONNES (GRILLE 4 COLONNES PLEINE LARGEUR)
  .agencyFooterBody {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 4.5rem 1.5rem 3.5rem 1.5rem;
    will-change: transform;
    transition: transform 0.05s linear;

    &__inner {
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.25fr 0.9fr 1.05fr 1.15fr;
      gap: 2rem;

      @media (max-width: 1024px) {
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
      }

      @media (max-width: 640px) {
        grid-template-columns: 1fr;
        gap: 1.75rem;
      }
    }
  }

  .agencyFooterCol {
    display: flex;
    flex-direction: column;
    background: rgba(8, 12, 22, 0.84);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(212, 175, 55, 0.22);
    border-radius: var(--ag-radius-lg);
    padding: 1.85rem 1.6rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    transition: transform 0.25s ease, border-color 0.25s ease;

    &:hover {
      border-color: rgba(212, 175, 55, 0.45);
      transform: translateY(-2px);
    }

    &.--brand {
      gap: 0.5rem;
    }

    &__brandHeader {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }

    &__logoMark {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 8px;
      background: rgba(212, 175, 55, 0.12);
      border: 1px solid rgba(212, 175, 55, 0.3);
      flex-shrink: 0;
    }

    &__brandName {
      font-size: 1.35rem;
      font-weight: 900;
      letter-spacing: -0.01em;
      color: #ffffff;
      margin: 0;
    }

    &__tagline {
      font-size: 0.88rem;
      font-weight: 700;
      color: #FDE68A;
      margin: 0 0 0.5rem 0;
    }

    &__desc {
      font-size: 0.85rem;
      color: var(--ag-text-muted);
      line-height: 1.6;
      margin: 0 0 1.25rem 0;
    }

    &__heading {
      font-size: 1rem;
      font-weight: 900;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #ffffff;
      margin: 0 0 1.5rem 0;
      position: relative;
      padding-bottom: 0.65rem;

      &::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 28px;
        height: 2px;
        background: var(--ag-gold);
      }
    }
  }

  .agencyFooterOpeningStatus {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 1rem;
    border-radius: var(--ag-radius-full);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.28);
    margin-bottom: 1.5rem;
    width: fit-content;

    &__dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #10B981;
      flex-shrink: 0;
      animation: pulse 2s infinite;
    }

    &__text {
      font-size: 0.8rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: 0.01em;
    }
  }

  .agencyFooterSocials {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);

    &__label {
      display: block;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ag-text-muted);
      margin-bottom: 0.65rem;
    }

    &__list {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    &__link {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(212, 175, 55, 0.2);
      color: #FDE68A;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: all 0.2s ease;

      &:hover {
        background: var(--ag-gold);
        color: #07090E;
        transform: translateY(-2px);
      }
    }
  }

  .agencyFooterNav {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;

    &__link {
      font-size: 0.88rem;
      color: var(--ag-text-muted);
      text-decoration: none;
      transition: color 0.15s ease, transform 0.15s ease;
      display: inline-block;

      &:hover {
        color: #FDE68A;
        transform: translateX(3px);
      }
    }
  }

  .agencyFooterContacts {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .agencyFooterContactItem {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    text-decoration: none;
    transition: all 0.2s ease;

    &:hover {
      background: rgba(212, 175, 55, 0.08);
      border-color: rgba(212, 175, 55, 0.35);
      transform: translateX(3px);
    }

    &__icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: rgba(212, 175, 55, 0.12);
      color: var(--ag-gold);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;

      &.--wa {
        background: rgba(16, 185, 129, 0.12);
        color: #10B981;
      }
    }

    &__label {
      display: block;
      font-size: 0.7rem;
      color: var(--ag-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    &__val {
      font-size: 0.86rem;
      font-weight: 800;
      color: #ffffff;
    }
  }

  .agencyFooterAstreinteNote {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.75rem 0.85rem;
    border-radius: 8px;
    background: rgba(212, 175, 55, 0.06);
    border: 1px solid rgba(212, 175, 55, 0.2);
    font-size: 0.75rem;
    color: #FDE68A;
    line-height: 1.45;
    margin-top: 0.5rem;

    &__dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--ag-gold);
      flex-shrink: 0;
      margin-top: 5px;
    }
  }

  .agencyFooterAddress {
    font-style: normal;
    display: flex;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: #e2e8f0;
    line-height: 1.5;
    margin-bottom: 1.25rem;

    &__pin {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: rgba(212, 175, 55, 0.12);
      border: 1px solid rgba(212, 175, 55, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    strong {
      display: block;
      color: #ffffff;
      font-size: 0.92rem;
      margin-bottom: 0.2rem;
    }

    p {
      margin: 0;
    }
  }

  // Façade Leaflet de la carte (Sobre et biseautée)
  .agencyMapFacade {
    background: #080C14;
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    min-height: 160px;
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.5);

    &__preview {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 1rem;
      text-align: center;
      background: radial-gradient(circle at 50% 50%, rgba(212, 175, 55, 0.08) 0%, #080C14 85%);
    }

    &__pin {
      animation: bounce 1.8s infinite;
      margin-bottom: 0.35rem;
    }

    &__label {
      font-size: 0.8rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 0.75rem;
    }

    &__btn {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.55rem 1.15rem;
      border-radius: var(--ag-radius-full);
      background: linear-gradient(135deg, #D4AF37 0%, #F59E0B 100%);
      color: #07090E;
      font-weight: 800;
      font-size: 0.78rem;
      border: none;
      cursor: pointer;
      transition: transform 0.15s ease, opacity 0.15s ease;

      &:hover {
        transform: translateY(-1px);
        opacity: 0.95;
      }
    }
  }

  .agencyFooterGpsLink {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.65rem 0.85rem;
    border-radius: 8px;
    background: rgba(212, 175, 55, 0.08);
    border: 1px solid rgba(212, 175, 55, 0.25);
    color: #FDE68A;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    margin-top: 0.75rem;
    transition: all 0.2s ease;

    &:hover {
      background: rgba(212, 175, 55, 0.16);
      color: #ffffff;
    }
  }

  // PALIER 3 : SOUS-FOOTER PLEINE LARGEUR (COLOPHON & RÉASSURANCE)
  .agencyFooterBottom {
    position: relative;
    z-index: 1;
    width: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(3, 4, 7, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 1.35rem 1.5rem;
    font-size: 0.82rem;
    color: var(--ag-text-muted);

    &__inner {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1.25rem;
    }

    &__copy {
      margin: 0;
    }

    &__badges {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      flex-wrap: wrap;
    }

    &__badge {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.75rem;
      color: #cbd5e1;
    }

    &__links {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    &__link {
      color: var(--ag-text-muted);
      text-decoration: none;
      transition: color 0.15s ease;

      &:hover {
        color: #FDE68A;
      }

      &.--admin {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--ag-gold);
        font-weight: 700;
        padding: 0.25rem 0.6rem;
        border-radius: 6px;
        background: rgba(212, 175, 55, 0.08);
        border: 1px solid rgba(212, 175, 55, 0.25);

        &:hover {
          background: rgba(212, 175, 55, 0.18);
          color: #ffffff;
        }
      }
    }

    &__sep {
      color: rgba(212, 175, 55, 0.3);
    }
  }

  @keyframes rotateSlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  // 9. MODALE SIMULATEUR DE DEVIS (<dialog>)
  .agencySimModal {
    border: none;
    background: transparent;
    padding: 0;
    max-width: 900px;
    width: 92vw;
    color: var(--ag-text);

    &::backdrop {
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(8px);
    }

    &__card {
      background: #0F172A;
      border: 1.5px solid rgba(212, 175, 55, 0.4);
      border-radius: var(--ag-radius-lg);
      padding: 2.25rem;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85);
      max-height: 88vh;
      overflow-y: auto;
    }

    &__header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--ag-border);
      padding-bottom: 1rem;
    }

    &__eyebrow {
      font-size: 0.75rem;
      font-weight: 800;
      color: var(--ag-gold);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    &__title {
      font-size: 1.6rem;
      font-weight: 900;
      color: #ffffff;
      margin: 0.25rem 0 0 0;
    }

    &__close {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
      color: #ffffff;
      font-size: 1.1rem;
      border: none;
      cursor: pointer;
    }
  }

  .agencySimStep {
    border: none;
    padding: 0;
    margin: 0 0 2rem 0;

    &__legend {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-size: 1.05rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 1rem;
    }

    &__num {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--ag-gold) 0%, var(--ag-amber) 100%);
      color: #0A0E17;
      font-size: 0.8rem;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    &__options {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.65rem;

      @media (min-width: 600px) {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    &__packs {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.85rem;

      @media (min-width: 640px) {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    &__addons {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
  }

  .agencySimOption {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 1rem;
    border-radius: var(--ag-radius-sm);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--ag-border);
    cursor: pointer;
    font-size: 0.85rem;

    &.--active {
      background: rgba(212, 175, 55, 0.15);
      border-color: var(--ag-gold);
      color: #ffffff;
      font-weight: 700;
    }
  }

  .agencySimPack {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: var(--ag-radius-md);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--ag-border);
    cursor: pointer;

    &.--active {
      background: rgba(212, 175, 55, 0.12);
      border-color: var(--ag-gold);
    }

    &__content {
      display: flex;
      flex-direction: column;
    }

    &__title {
      font-size: 0.95rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 0.2rem;
    }

    &__desc {
      font-size: 0.75rem;
      color: var(--ag-text-muted);
      margin-bottom: 0.4rem;
    }

    &__price {
      font-size: 1.05rem;
      font-weight: 900;
      color: var(--ag-gold);
    }
  }

  .agencySimAddon {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: var(--ag-radius-sm);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--ag-border);
    cursor: pointer;

    &__info {
      display: flex;
      flex-direction: column;
    }

    &__title {
      font-size: 0.88rem;
      font-weight: 700;
      color: #ffffff;
    }

    &__sub {
      font-size: 0.75rem;
      color: var(--ag-text-muted);
    }
  }

  .agencySimSummary {
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--ag-border);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;

    @media (min-width: 680px) {
      grid-template-columns: 1.2fr 0.8fr;
    }

    &__breakdown {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    &__row {
      display: flex;
      justify-content: space-between;
      font-size: 0.88rem;
      color: #cbd5e1;

      &.--total {
