      <details class="agencyFabTools__details">
        <summary class="agencyFabTools__trigger" aria-label="Ouvrir le menu des outils rapides">
          <svg class="agencyFabTools__icon --main" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
          <svg class="agencyFabTools__icon --close" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </summary>

        <div class="agencyFabTools__menu">
          <button type="button" class="agencyFabTools__item openSimulatorTrigger">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="4" y="2" width="16" height="20" rx="2"></rect>
              <line x1="8" y1="6" x2="16" y2="6"></line>
              <line x1="16" y1="14" x2="16" y2="18"></line>
            </svg>
            <span>Simulateur Devis</span>
          </button>

          <button type="button" class="agencyFabTools__item openWaveModalTrigger" data-amount="50000">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <circle cx="12" cy="12" r="10" fill="#1898E8"/>
              <path d="M8 12l3 3 5-5" stroke="#fff" stroke-width="2" fill="none"/>
            </svg>
            <span>Paiement Wave QR</span>
          </button>

          <a href="/admin-agency" class="agencyFabTools__item">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>Espace Partenaire & Admin</span>
          </a>

          <button type="button" class="agencyFabTools__item" id="agencyScrollTopBtn">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
            <span>Haut de page</span>
          </button>
        </div>
      </details>
    </aside>

    <!-- BAS DROIT : CONTACT SPEED-DIAL (WHATSAPP + TÉLÉPHONE - SVG UNIQUEMENT) -->
    <aside class="agencyFabContact" aria-label="Contact rapide agence">
      <details class="agencyFabContact__details">
        <summary class="agencyFabContact__trigger" aria-label="Ouvrir les options de contact rapide">
          <svg class="agencyFabContact__icon --chat" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
            <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/>
          </svg>
          <svg class="agencyFabContact__icon --close" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </summary>

        <div class="agencyFabContact__menu">
          <a
            href={`https://wa.me/${whatsappClean}?text=${encodeURIComponent("Bonjour WebAgency Abidjan, je vous écris depuis votre portfolio pour des informations.")}`}
            class="agencyFabContact__btn --wa"
            target="_blank"
            rel="noopener"
            aria-label="Discussion directe sur WhatsApp"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
            </svg>
            <span>WhatsApp Direct</span>
          </a>

          <a
            href={`tel:${phoneClean}`}
            class="agencyFabContact__btn --phone"
            aria-label={`Appeler le ${agencyData.contact.phoneDisplay}`}
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
            </svg>
            <span>Appeler l'Agence</span>
          </a>
        </div>
      </details>
    </aside>

    <!-- Panier d'achat coulissant -->
    <CartDrawer />
  </div>
</Layout>

<script>
  import QRCode from 'qrcode';
  import { getStorage, updateStorage } from '../lib/storage';
  import { agencyData } from '../data/agencyData';

  const whatsappClean = agencyData.contact.whatsapp.replace(/[^0-9]/g, '');

  // 1. Sticky Header & Parallax Multi-Profondeurs au défilement
  const header = document.getElementById('agencyHeader');
  const parallaxBg = document.getElementById('parallaxBg');
  const parallaxContent = document.getElementById('parallaxContent');
  const parallaxMesh = document.getElementById('parallaxMesh');
  const parallaxBadge1 = document.getElementById('parallaxBadge1');
  const parallaxBadge2 = document.getElementById('parallaxBadge2');
  const parallaxBadge3 = document.getElementById('parallaxBadge3');
  const parallaxSection = document.getElementById('parallaxSection');

  function updateStickyHeader() {
    if (header) {
      if (window.scrollY > 20) {
        header.classList.add('--stuck');
      } else {
        header.classList.remove('--stuck');
      }
    }
  }

  updateStickyHeader();

  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    const winHeight = window.innerHeight;

    // Sticky header transform (réduction au défilement)
    updateStickyHeader();

    // Parallax multi-profondeurs sur la section vitrine
    if (parallaxSection && parallaxBg && parallaxContent) {
      const rect = parallaxSection.getBoundingClientRect();
      if (rect.top < winHeight && rect.bottom > 0) {
        const centerOffset = ((rect.top + rect.height / 2) - winHeight / 2) / (winHeight / 2);

        parallaxBg.style.transform = `translateY(${centerOffset * 75}px) scale(1.12)`;

        if (parallaxMesh) {
          parallaxMesh.style.transform = `translateY(${centerOffset * 40}px)`;
        }

        parallaxContent.style.transform = `translateY(${-centerOffset * 35}px)`;

        if (parallaxBadge1) {
          parallaxBadge1.style.transform = `translateY(${-centerOffset * 60}px) rotate(2deg)`;
        }
        if (parallaxBadge2) {
          parallaxBadge2.style.transform = `translateY(${centerOffset * 50}px) rotate(-2.5deg)`;
        }
        if (parallaxBadge3) {
          parallaxBadge3.style.transform = `translateY(${-centerOffset * 45}px) rotate(1.5deg)`;
        }
      }
    }

    // Parallax visible et immersif sur TOUS les blocs de contenu (même comportement multi-profondeurs)
    const parallaxBlocks = document.querySelectorAll<HTMLElement>('[data-parallax-block]');
    parallaxBlocks.forEach((block) => {
      const rect = block.getBoundingClientRect();
      if (rect.top < winHeight && rect.bottom > 0) {
        const centerOffset = ((rect.top + rect.height / 2) - winHeight / 2) / (winHeight / 2);
        const bg = block.querySelector<HTMLElement>('.agencySectionParallaxBg');
        const container = block.querySelector<HTMLElement>('.agencyValues__container, .agencyProjects__container, .agencyServices__container, .agencyFaq__container');
        const floatEl = block.querySelector<HTMLElement>('.agencySectionParallaxFloat');

        // 1. Fond image : translation dynamique
        if (bg) {
          bg.style.transform = `translateY(${centerOffset * 80}px) scale(1.12)`;
        }
        // 2. Contenu au premier plan : contre-mouvement subtil accentuant le relief 3D
        if (container) {
          container.style.transform = `translateY(${-centerOffset * 30}px)`;
        }
        // 3. Éléments flottants : vitesse décalée
        if (floatEl) {
          floatEl.style.transform = `translateY(${-centerOffset * 55}px) rotate(${centerOffset * 6}deg)`;
        }
      }
    });

    // Parallax sur l'arrière-plan anime BD du footer
    const footerEl = document.getElementById('contact');
    const footerBg = document.getElementById('footerParallaxBg');
    if (footerEl && footerBg) {
      const rect = footerEl.getBoundingClientRect();
      if (rect.top < winHeight && rect.bottom > 0) {
        const centerOffset = ((rect.top + rect.height / 2) - winHeight / 2) / (winHeight / 2);
        footerBg.style.transform = `translateY(${centerOffset * 75}px) scale(1.12)`;
        const footerBody = footerEl.querySelector<HTMLElement>('.agencyFooterBody');
        if (footerBody) {
          footerBody.style.transform = `translateY(${-centerOffset * 25}px)`;
        }
      }
    }
  }, { passive: true });

  // 1.b. Blocs Foldables (Repliés par défaut) : Services et FAQ
  const toggleServicesBtn = document.getElementById('toggleServicesFoldBtn');
  const servicesFoldable = document.getElementById('servicesFoldableBody');
  const servicesFoldLabel = document.getElementById('servicesFoldLabel');

  toggleServicesBtn?.addEventListener('click', () => {
    const isExpanded = servicesFoldable?.classList.toggle('--expanded');
    toggleServicesBtn.setAttribute('aria-expanded', String(isExpanded));
    toggleServicesBtn.classList.toggle('--active', isExpanded);
    if (servicesFoldLabel) {
      servicesFoldLabel.textContent = isExpanded ? 'Voir moins' : 'Voir plus';
    }
  });

  const toggleFaqBtn = document.getElementById('toggleFaqFoldBtn');
  const faqFoldable = document.getElementById('faqFoldableBody');
  const faqFoldLabel = document.getElementById('faqFoldLabel');

  toggleFaqBtn?.addEventListener('click', () => {
    const isExpanded = faqFoldable?.classList.toggle('--expanded');
    toggleFaqBtn.setAttribute('aria-expanded', String(isExpanded));
    toggleFaqBtn.classList.toggle('--active', isExpanded);
    if (faqFoldLabel) {
      faqFoldLabel.textContent = isExpanded ? 'Voir moins' : 'Voir plus';
    }
  });

  // 2. Gestion du Panier & Badge Header
  function updateHeaderCartBadge() {
    const data = getStorage();
    const count = (data.cart || []).reduce((acc, item) => acc + item.quantity, 0);
    const badge = document.getElementById('headerCartBadge');
    if (badge) {
      badge.textContent = String(count);
      badge.style.display = count > 0 ? 'flex' : 'none';
    }
  }

  window.addEventListener('app:storage:change', updateHeaderCartBadge);
  document.getElementById('headerCartBtn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cart:open'));
  });
  updateHeaderCartBadge();

  // Boutons "Ajouter au Panier" sur les cartes de packs
  document.querySelectorAll('.addPackToCartBtn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const id = target.dataset.id || 'pack';
      const name = target.dataset.name || 'Pack Web';
      const price = Number(target.dataset.price) || 150000;

      const current = getStorage();
      const existing = (current.cart || []).find((it) => it.id === id);
      let newCart;
      if (existing) {
        newCart = current.cart.map((it) => it.id === id ? { ...it, quantity: it.quantity + 1 } : it);
      } else {
        newCart = [...(current.cart || []), { id, name, price, quantity: 1 }];
      }

      updateStorage((prev) => ({ ...prev, cart: newCart }));
      window.dispatchEvent(new CustomEvent('cart:open'));
    });
  });

  // 3. Filtrage interactif des Réalisations
  const filterBtns = document.querySelectorAll('.agencyFilterBtn');
  const projectCards = document.querySelectorAll('.agencyProjectCard');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('--active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('--active');
      btn.setAttribute('aria-selected', 'true');

      const filter = (btn as HTMLElement).dataset.filter || 'all';
      projectCards.forEach((card) => {
        const cat = (card as HTMLElement).dataset.category || '';
        if (filter === 'all' || cat.toLowerCase().includes(filter.toLowerCase())) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // 4. Modale Simulateur de Devis (<dialog>)
  const simModal = document.getElementById('agencySimulatorModal') as HTMLDialogElement | null;
  const closeSimModalBtn = document.getElementById('closeSimModalBtn');

  document.querySelectorAll('.openSimulatorTrigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      simModal?.showModal();
    });
  });

  closeSimModalBtn?.addEventListener('click', () => {
    simModal?.close();
  });

  // Calcul du Simulateur
  const simActivityInputs = document.querySelectorAll<HTMLInputElement>('input[name="simActivity"]');
  const simPackInputs = document.querySelectorAll<HTMLInputElement>('input[name="simPack"]');
  const simAddonInputs = document.querySelectorAll<HTMLInputElement>('input[name="simAddon"]');
  const modalSummaryPackName = document.getElementById('modalSummaryPackName');
  const modalSummaryTimeline = document.getElementById('modalSummaryTimeline');
  const modalSummaryTotal = document.getElementById('modalSummaryTotal');
  const modalSummaryDeposit = document.getElementById('modalSummaryDeposit');

  function calculateModalSimulation() {
    let basePrice = 150000;
    let packName = 'Pack Vitrine Commerce B2C';
    let timeline = '3 à 5 jours ouvrés';
    let activity = 'Salon / Beauté';

    simActivityInputs.forEach((inp) => {
      if (inp.checked) {
        activity = inp.value;
        document.querySelectorAll('.agencySimOption').forEach((el) => el.classList.remove('--active'));
        inp.closest('.agencySimOption')?.classList.add('--active');
      }
    });

    simPackInputs.forEach((inp) => {
      if (inp.checked) {
        basePrice = Number(inp.value);
        packName = inp.dataset.name || 'Pack Vitrine B2C';
        if (basePrice === 150000) timeline = '3 à 5 jours ouvrés';
        if (basePrice === 250000) timeline = '5 à 7 jours ouvrés';
        if (basePrice === 380000) timeline = '7 à 10 jours ouvrés';
        if (basePrice === 95000) timeline = '48 heures';

        document.querySelectorAll('.agencySimPack').forEach((el) => el.classList.remove('--active'));
        inp.closest('.agencySimPack')?.classList.add('--active');
      }
    });

    let addonsTotal = 0;
    const selectedAddons: string[] = [];
    simAddonInputs.forEach((chk) => {
      if (chk.checked) {
        addonsTotal += Number(chk.value);
        selectedAddons.push(chk.dataset.name || '');
      }
    });

    const totalPrice = basePrice + addonsTotal;
    const depositPrice = Math.round(totalPrice * 0.3);

    if (modalSummaryPackName) modalSummaryPackName.textContent = packName;
    if (modalSummaryTimeline) modalSummaryTimeline.textContent = timeline;
    if (modalSummaryTotal) modalSummaryTotal.textContent = `${new Intl.NumberFormat('fr-FR').format(totalPrice)} FCFA`;
    if (modalSummaryDeposit) modalSummaryDeposit.textContent = `${new Intl.NumberFormat('fr-FR').format(depositPrice)} FCFA`;

    return { activity, packName, timeline, totalPrice, depositPrice, selectedAddons };
  }

  simActivityInputs.forEach((inp) => inp.addEventListener('change', calculateModalSimulation));
  simPackInputs.forEach((inp) => inp.addEventListener('change', calculateModalSimulation));
  simAddonInputs.forEach((chk) => chk.addEventListener('change', calculateModalSimulation));

  document.getElementById('modalSimSendWhatsappBtn')?.addEventListener('click', () => {
    const data = calculateModalSimulation();
    const text = `*DEMANDE DE DEVIS — WEBAGENCY ABIDJAN*
• Activité : ${data.activity}
• Formule : ${data.packName}
• Options : ${data.selectedAddons.length > 0 ? data.selectedAddons.join(', ') : 'Aucune option supplémentaire'}
• Total estimé : ${new Intl.NumberFormat('fr-FR').format(data.totalPrice)} FCFA
• Acompte 30% : ${new Intl.NumberFormat('fr-FR').format(data.depositPrice)} FCFA
• Délai : ${data.timeline}

Bonjour, je souhaite valider ce devis et planifier mon site web.`;

    const url = `https://wa.me/${whatsappClean}?text=${encodeURIComponent(text)}`;
    window.open(url, '_blank', 'noopener');
  });

  document.getElementById('modalSimPayWaveBtn')?.addEventListener('click', () => {
    const data = calculateModalSimulation();
    simModal?.close();
    openWaveModal(data.depositPrice);
  });

  // 5. Modale Tunnel Wave (<dialog>)
  const waveModal = document.getElementById('agencyWaveModal') as HTMLDialogElement | null;
  const closeWaveModalBtn = document.getElementById('closeWaveModalBtn');
  const waveAmountInput = document.getElementById('waveModalAmountInput') as HTMLInputElement | null;
  const waveAmountPill = document.getElementById('waveModalAmountPill');
  const waveQrImg = document.getElementById('waveModalQrImg') as HTMLImageElement | null;
  const waveDeepLinkBtn = document.getElementById('waveModalDeepLinkBtn') as HTMLAnchorElement | null;
  const waveCopyBtn = document.getElementById('waveModalCopyLinkBtn');
  const waveCopyText = document.getElementById('waveModalCopyText');
  const wavePresets = document.querySelectorAll('.agencyWaveModalPreset');

  function getWaveUrl(amount: number) {
    return `https://pay.wave.com/m/${whatsappClean}?amount=${amount}`;
  }

  async function updateWaveModal(amount: number) {
    const validAmount = Math.max(500, Number(amount) || 50000);
    const formatted = new Intl.NumberFormat('fr-FR').format(validAmount);

    if (waveAmountPill) waveAmountPill.textContent = `${formatted} FCFA`;
    const url = getWaveUrl(validAmount);
    if (waveDeepLinkBtn) waveDeepLinkBtn.href = url;

    if (waveQrImg) {
      try {
        const qrDataUrl = await QRCode.toDataURL(url, {
          width: 180,
          margin: 1,
          color: { dark: '#000000', light: '#ffffff' }
        });
        waveQrImg.src = qrDataUrl;
      } catch (err) {
        console.error('Erreur QR Wave:', err);
      }
    }

    wavePresets.forEach((btn) => {
      const btnAmt = Number((btn as HTMLElement).dataset.amount);
      btn.classList.toggle('--active', btnAmt === validAmount);
    });
  }

  function openWaveModal(amount: number = 50000) {
    if (waveAmountInput) waveAmountInput.value = String(amount);
    updateWaveModal(amount);
    waveModal?.showModal();
  }

  document.querySelectorAll('.openWaveModalTrigger').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const amt = Number((e.currentTarget as HTMLElement).dataset.amount) || 50000;
      openWaveModal(amt);
    });
  });

  closeWaveModalBtn?.addEventListener('click', () => {
    waveModal?.close();
  });

  waveAmountInput?.addEventListener('input', () => {
    updateWaveModal(Number(waveAmountInput.value));
  });

  wavePresets.forEach((btn) => {
    btn.addEventListener('click', () => {
      const val = Number((btn as HTMLElement).dataset.amount) || 50000;
      if (waveAmountInput) waveAmountInput.value = String(val);
      updateWaveModal(val);
    });
  });

  waveCopyBtn?.addEventListener('click', async () => {
    const url = waveDeepLinkBtn?.href || '';
    try {
      await navigator.clipboard.writeText(url);
      if (waveCopyText) {
        waveCopyText.textContent = 'Lien Wave copié !';
        setTimeout(() => { waveCopyText.textContent = 'Copier le lien Wave'; }, 2500);
      }
    } catch {
      // Fallback
    }
  });

  // 6. Façade de Carte Interactive (OpenStreetMap / Leaflet chargée au clic)
  const loadMapBtn = document.getElementById('loadMapBtn');
  const mapPreview = document.getElementById('mapPreview');
  const mapFrame = document.getElementById('mapFrame');

  loadMapBtn?.addEventListener('click', () => {
    if (mapPreview && mapFrame) {
      mapPreview.style.display = 'none';
      mapFrame.style.display = 'block';
      // Chargement de la vue OpenStreetMap centrée sur Cocody Deux Plateaux
      mapFrame.innerHTML = `
        <iframe
          width="100%"
          height="220"
          frameborder="0"
          scrolling="no"
          marginheight="0"
          marginwidth="0"
          src="https://www.openstreetmap.org/export/embed.html?bbox=-4.008492%2C5.352692%2C-3.988492%2C5.372692&amp;layer=mapnik&amp;marker=5.362692%2C-3.998492"
          style="border: 0; border-radius: 10px;"
          title="Carte interactive des bureaux WebAgency Abidjan"
        ></iframe>
      `;
    }
  });

  // 7. Horaires de l'Agence en direct (Abidjan UTC+0)
  function checkAgencyHours() {
    const dot = document.getElementById('agencyOpeningDot');
    const text = document.getElementById('agencyOpeningText');
    if (!dot || !text) return;

    const now = new Date();
    const day = now.getUTCDay();
    const hour = now.getUTCHours();
    const minute = now.getUTCMinutes();
    const currentMin = hour * 60 + minute;

    let isOpen = false;
    if (day >= 1 && day <= 5) {
      if (currentMin >= 510 && currentMin <= 1110) isOpen = true;
    } else if (day === 6) {
      if (currentMin >= 540 && currentMin <= 900) isOpen = true;
    }

    if (isOpen) {
      dot.style.backgroundColor = '#10B981';
      text.textContent = 'Agence Ouverte actuellement à Abidjan (08h30 – 18h30)';
    } else {
      dot.style.backgroundColor = '#F59E0B';
      text.textContent = 'Fermé actuellement • Permanence WhatsApp 24/7 active';
    }
  }
  checkAgencyHours();

  // 8. Gestion du Mode Administrateur & Édition In-Situ de Texte
  const adminBar = document.getElementById('agencyAdminBar');
  const toggleInSituEdit = document.getElementById('toggleInSituEdit') as HTMLInputElement | null;
  const saveInSituChangesBtn = document.getElementById('saveInSituChangesBtn');
  const resetInSituChangesBtn = document.getElementById('resetInSituChangesBtn');
  const exitAdminModeBtn = document.getElementById('exitAdminModeBtn');
  const editableElements = document.querySelectorAll<HTMLElement>('.editableText');

  // Chargement des textes personnalisés s'ils existent en localStorage
  function loadSavedTexts() {
    try {
      const raw = localStorage.getItem('agency_custom_content');
      if (raw) {
        const texts = JSON.parse(raw);
        editableElements.forEach((el) => {
          const id = el.dataset.textId;
          if (id && texts[id]) {
            el.innerHTML = texts[id];
          }
        });
      }
    } catch {
      // Fallback
    }
  }

  function setInSituEditing(enabled: boolean) {
    editableElements.forEach((el) => {
      el.contentEditable = enabled ? 'true' : 'false';
      el.classList.toggle('--is-editing', enabled);
    });
    if (saveInSituChangesBtn) {
      saveInSituChangesBtn.style.display = enabled ? 'inline-flex' : 'none';
    }
  }

  toggleInSituEdit?.addEventListener('change', () => {
    setInSituEditing(Boolean(toggleInSituEdit.checked));
  });

  saveInSituChangesBtn?.addEventListener('click', () => {
    const textsToSave: Record<string, string> = {};
    editableElements.forEach((el) => {
      const id = el.dataset.textId;
      if (id) {
        textsToSave[id] = el.innerHTML;
      }
    });
    localStorage.setItem('agency_custom_content', JSON.stringify(textsToSave));
    saveInSituChangesBtn.textContent = '✓ Textes Enregistrés !';
    setTimeout(() => {
      if (saveInSituChangesBtn) saveInSituChangesBtn.textContent = '💾 Enregistrer Textes';
    }, 2000);
  });

  resetInSituChangesBtn?.addEventListener('click', () => {
    if (confirm('Voulez-vous réinitialiser tous les textes personnalisés ?')) {
      localStorage.removeItem('agency_custom_content');
      window.location.reload();
    }
  });

  exitAdminModeBtn?.addEventListener('click', () => {
    updateStorage((prev) => ({ ...prev, sim: { role: 'public' } }));
    window.location.href = '/web-agency-abidjan';
  });

  // Vérification de l'état Admin
  const storageData = getStorage();
  const urlParams = new URLSearchParams(window.location.search);
  const isAdminRole = storageData?.sim?.role === 'admin' || urlParams.get('admin_edit') === 'true';

  if (isAdminRole && adminBar) {
    adminBar.style.display = 'block';
    if (urlParams.get('admin_edit') === 'true' && toggleInSituEdit) {
      toggleInSituEdit.checked = true;
      setInSituEditing(true);
    }
  }

  loadSavedTexts();

  // 9. Retour en haut
  document.getElementById('agencyScrollTopBtn')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>

