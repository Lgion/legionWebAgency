---
import Layout from '../layouts/Layout.astro';
import { client } from '../lib/client';
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer/Footer.astro';
import FabContact from '../components/FabContact/FabContact.astro';
import FabTools from '../components/FabTools/FabTools.astro';
import ServiceCard from '../components/ServiceCard/ServiceCard.astro';
import Accordion from '../components/Accordion/Accordion.astro';
import CartDrawer from '../components/Cart/CartDrawer.astro';
import WaveModal from '../components/WaveModal/WaveModal.astro';
import ActionHub from '../components/ActionHub/ActionHub.astro';
import SeasonalShowcase from '../components/SeasonalShowcase/SeasonalShowcase.astro';

const whatsappClean = client.contact.whatsapp.replace(/[^0-9]/g, '');
const phoneClean = client.contact.phone.replace(/[^0-9+]/g, '');

// Extraction dynamique des catégories de prestations pour les onglets de filtrage
const serviceCategories = Array.from(new Set(client.services.map((s) => s.category)));

const faqs = [
  {
    title: "Jusqu'à quelle taille pouvez-vous agrandir et encadrer une photo ?",
    content: "Dans notre espace Studio Photo Maria, nous réalisons tous les formats de tirage photo jusqu'au très grand format 2 mètres sur 2 mètres (2m × 2m). Nous proposons également l'impression photo sur bois, les cadres vitrés et tous types d'encadrements sur mesure.",
    defaultOpen: true
  },
  {
    title: "Pouvez-vous restaurer une ancienne photo abîmée ou d'un parent décédé ?",
    content: "Oui, c'est l'une de nos spécialités. Vous pouvez nous apporter une ancienne photo physique : nous la numérisons par ordinateur, réparons les défauts, changeons l'arrière-plan selon votre souhait et l'agrandissons avec un encadrement hommage de haute qualité."
  },
  {
    title: "En combien de temps fabriquez-vous un cachet d'entreprise ?",
    content: "Nous fabriquons votre cachet d'entreprise sur-le-champ ! Vous vous asseyez au comptoir avec les informations de votre société, nous concevons la maquette immédiatement et vous repartez avec votre cachet prêt à l'emploi."
  },
  {
    title: "Puis-je commander un téléphone (iPhone, Samsung, Tecno) de grande capacité ?",
    content: "Tout à fait. En plus de notre stock exposé en vitrine, nous travaillons directement avec les fournisseurs partenaires officiels (Samsung, iPhone, Tecno, Itel). Si vous cherchez un modèle précis ou une grande capacité mémoire, nous le faisons venir sur commande rapidement."
  },
  {
    title: "Comment fonctionnent les dépôts, retraits Mobile Money et paiements en boutique ?",
    content: "Pour votre sécurité, tous les dépôts et retraits d'espèces (Wave, Orange Money, MTN MoMo, Push, Djamo) s'effectuent physiquement à notre guichet dans la galerie du Super U après confirmation du nom du bénéficiaire. Pour régler vos achats ou prestations, vous pouvez payer par QR Code Wave, Orange Money ou par Carte Visa."
  },
  {
    title: "Faut-il prendre rendez-vous ou proposez-vous la livraison sur Abidjan ?",
    content: "L'accès à la boutique, aux impressions, aux cachets et au Mobile Money se fait sans rendez-vous du lundi au samedi de 09h00 à 20h00. Pour les shootings studio et reportages mariage/cérémonie, la réservation sur WhatsApp est conseillée. Nous livrons également vos commandes partout à Abidjan."
  }
];
---

<Layout image="/images/entree.jpeg">
  <Header />

  <main class="homePage">
    <!-- 1. HERO PRESTIGE BLEU MARINE & OR -->
    <section class="prestigeHero">
      <div class="prestigeHero__container">
        <div class="prestigeHero__content">
          <div class="prestigeHero__badges">
            <span class="prestigeHero__locBadge">
              📍 Galerie Super U Deux Plateaux (Sococé)
            </span>
            <span class="prestigeHero__hoursBadge">
              🕘 Lun – Sam : 09h00 – 20h00
            </span>
          </div>

          <h1 class="prestigeHero__title">
            {client.name}
            <span class="prestigeHero__titleGold">Studio Photo Maria & Pôle Multiservices</span>
          </h1>

          <p class="prestigeHero__pitch">{client.activity.pitch}</p>

          <!-- Les 5 Pôles en un coup d'œil -->
          <ul class="prestigeHero__poles" aria-label="Nos 5 domaines d'expertise">
            <li><a href="#prestations" data-filter-jump="Photo & Vidéo">📸 Studio Photo & Cadres 2m×2m</a></li>
            <li><a href="#prestations" data-filter-jump="Bureautique & Démarches">🖨️ Impression, Visa & Cachets Express</a></li>
            <li><a href="#prestations" data-filter-jump="Réparation Tech">🛠️ Réparation Téléphones, PC & Piles</a></li>
            <li><a href="#produits">🎮 Boutique Tech, Gaming & Bijoux</a></li>
            <li><a href="#mobile-money">📲 Agence Wave, Orange, MTN & Push</a></li>
          </ul>

          <div class="prestigeHero__actions">
            <a
              href={`https://wa.me/${whatsappClean}?text=${encodeURIComponent('Bonjour Business Center Prestige Services, je vous contacte depuis votre site internet pour une demande de tarif ou réservation.')}`}
              class="heroBtn --whatsapp"
              target="_blank"
              rel="noopener"
            >
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
              </svg>
              <span>Devis & Réservation WhatsApp</span>
            </a>

            <button type="button" class="heroBtn --wave openWaveModalTrigger">
              <span>💳 Payer par QR Wave</span>
            </button>

            <a href={`tel:${phoneClean}`} class="heroBtn --outline">
              <span>📞 {client.contact.phone}</span>
            </a>
          </div>
        </div>

        <!-- Mosaïque Photos Réelles de la Boutique -->
        <div class="prestigeHero__visual">
          <figure class="prestigeHero__mainPhoto">
            <img
              src="/images/entree.jpeg"
              alt="Devanture Business Center Prestige Services et Studio Photo Maria au Super U Deux Plateaux Sococé"
              width="640"
              height="420"
              fetchpriority="high"
            />
            <figcaption>
              <strong>Galerie Super U Deux Plateaux</strong> • Accès sécurisé & parking gratuit
            </figcaption>
          </figure>
          <div class="prestigeHero__subPhotos">
            <figure>
              <img
                src="/images/produits_boutique.jpeg"
                alt="Rayons électronique, pochettes, gaming et accessoires"
                width="300"
                height="200"
                loading="eager"
              />
              <figcaption>Boutique High-Tech & Accessoires</figcaption>
            </figure>
            <figure>
              <img
                src="/images/tranferts_wave_push.jpeg"
                alt="Comptoir d'accueil et transferts Mobile Money Wave Orange MTN"
                width="300"
                height="200"
                loading="eager"
              />
              <figcaption>Guichet Mobile Money & Accueil</figcaption>
            </figure>
          </div>
        </div>
      </div>

      <!-- Séparateur SVG travaillé -->
      <div class="prestigeHero__divider" aria-hidden="true">
        <svg viewBox="0 0 1440 56" fill="none" preserveAspectRatio="none">
          <path d="M0 56L1440 56L1440 16C1180 54 920 0 720 24C520 48 260 4 0 36L0 56Z" fill="var(--color-surface, #FAF8F5)"/>
        </svg>
      </div>
    </section>

    <!-- 2. RUBAN DES ATOUTS DIFFÉRENCIATEURS -->
    <section class="trustStrip" aria-label="Pourquoi nous choisir">
      <div class="trustStrip__container">
        <ul class="trustStrip__list">
          {client.activity.differentiators.map((diff) => (
            <li class="trustStrip__item">
              <span class="trustStrip__star" aria-hidden="true">★</span>
              <span>{diff}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 2bis. ESPACE DÉMARCHES EXPRESS & SIMULATEUR DE DEVIS (ActionHub) -->
    <ActionHub />

    <!-- 3. OFFRES & PROMOTIONS PHARES -->
    {client.promotions && client.promotions.length > 0 && (
      <section class="section --gold" id="promotions">
        <div class="section__container">
          <div class="section__header">
            <span class="section__eyebrow">Offres Spéciales & Forfaits</span>
            <h2 class="section__title">Nos Promotions du Moment</h2>
            <p class="section__subtitle">Tarifs très abordables et devis personnalisé gratuit sur WhatsApp.</p>
          </div>

          <div class="promoGrid">
            {client.promotions.map((promo) => (
              <article class="promoCard">
                {promo.badge && <span class="promoCard__badge">{promo.badge}</span>}
                <h3 class="promoCard__title">{promo.title}</h3>
                <p class="promoCard__desc">{promo.description}</p>
                <a
                  href={`https://wa.me/${whatsappClean}?text=${encodeURIComponent('Bonjour, je souhaite profiter de l\'offre : ' + promo.title)}`}
                  target="_blank"
                  rel="noopener"
                  class="promoCard__cta"
                >
                  <span>{promo.ctaText || 'En profiter sur WhatsApp'}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 4. NOS 5 PÔLES DE PRESTATIONS (AVEC ONGLETS DE FILTRAGE COMPACTS) -->
    <section class="section" id="prestations">
      <div class="section__container">
        <div class="section__header">
          <span class="section__eyebrow">Un service tout-en-un à Deux Plateaux</span>
          <h2 class="section__title">Nos Prestations & Services sur Place</h2>
          <p class="section__subtitle">
            Sélectionnez un pôle pour filtrer nos services. Cliquez sur une prestation pour voir la fiche détaillée, l'ajouter au panier ou réserver sur WhatsApp.
          </p>
        </div>

        <!-- Barre d'onglets de filtrage -->
        <div class="categoryTabs" role="tablist" aria-label="Filtrer les prestations par pôle">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            class="categoryTabs__btn --active"
            data-filter="all"
          >
            Tous les pôles ({client.services.length})
          </button>
          {serviceCategories.map((cat) => {
            const count = client.services.filter((s) => s.category === cat).length;
            return (
              <button
                type="button"
                role="tab"
                aria-selected="false"
                class="categoryTabs__btn"
                data-filter={cat}
              >
                {cat} ({count})
              </button>
            );
          })}
        </div>

        <div class="servicesGrid" id="servicesGridContainer">
          {client.services.map((service) => (
            <ServiceCard service={service} />
          ))}
        </div>
      </div>
    </section>

    <!-- 4bis. VITRINE SAISONNIÈRE (SeasonalShowcase) -->
    <SeasonalShowcase />

    <!-- 5. FOCUS AGENCE MOBILE MONEY & PAIEMENT WAVE / VISA -->
    <section class="section --navy" id="mobile-money">
      <div class="section__container">
        <div class="momoBanner">
          <div class="momoBanner__info">
            <span class="momoBanner__eyebrow">Guichet Sécurisé Super U Deux Plateaux</span>
            <h2 class="momoBanner__title">Agence Dépôt, Retrait & Paiement Mobile Money</h2>
            <p class="momoBanner__desc">
              Évitez les risques d'erreur : notre équipe vous accueille physiquement au guichet pour tous vos dépôts, retraits et transferts après vérification du nom du destinataire. Vous pouvez également régler tous vos achats et prestations en boutique par <strong>QR Code Wave</strong>, <strong>Orange Money</strong> ou <strong>Carte Bancaire Visa</strong>.
            </p>

            <ul class="momoBanner__operators" aria-label="Opérateurs disponibles">
              <li>Wave Côte d'Ivoire</li>
              <li>Orange Money</li>
              <li>MTN MoMo</li>
              <li>Push</li>
              <li>Djamo</li>
              <li>Carte Visa</li>
            </ul>

            <div class="momoBanner__actions">
              <button type="button" class="heroBtn --wave openWaveModalTrigger">
                💳 Afficher le QR Code de Paiement Wave
              </button>
              <a
                href={`https://wa.me/${whatsappClean}?text=${encodeURIComponent('Bonjour, j\'ai une question concernant votre guichet Mobile Money / Paiement.')}`}
                target="_blank"
                rel="noopener"
                class="heroBtn --outlineLight"
              >
                Poser une question sur WhatsApp
              </a>
            </div>
          </div>

          <figure class="momoBanner__figure">
            <img
              src="/images/tranferts_wave_push.jpeg"
              alt="Guichet Mobile Money chez Business Center Prestige Services au Super U Sococé"
              width="480"
              height="380"
              loading="lazy"
            />
            <figcaption>Opérations sécurisées au comptoir avec confirmation client</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 6. LA BOUTIQUE MULTI-RAYONS (ÉLECTRONIQUE, GAMING, BIJOUX & SAISON) -->
    {client.products && client.products.length > 0 && (
      <section class="section --alt" id="produits">
        <div class="section__container">
          <div class="section__header">
            <span class="section__eyebrow">Vente en Boutique & Sur Commande Partenaires</span>
            <h2 class="section__title">Notre Boutique High-Tech, Bijoux & Maroquinerie</h2>
            <p class="section__subtitle">
              Des centaines de références en rayon au Super U Deux Plateaux et arrivages réguliers. Ajoutez au panier ou commandez directement sur WhatsApp.
            </p>
          </div>

          <div class="productsGrid">
            {client.products.map((product) => (
              <article class="productShowcaseCard" id={`product-${product.slug}`}>
                {product.image && (
                  <div class="productShowcaseCard__media">
                    <img src={product.image} alt={product.name} width="400" height="220" loading="lazy" />
                    {product.badge && <span class="productShowcaseCard__badge">{product.badge}</span>}
                  </div>
                )}
                <div class="productShowcaseCard__body">
                  <span class="productShowcaseCard__category">{product.category}</span>
                  <h3 class="productShowcaseCard__title">{product.name}</h3>
                  <p class="productShowcaseCard__description">{product.description}</p>
                  <div class="productShowcaseCard__footer">
                    <span class="productShowcaseCard__price">
                      <strong>
                        {product.priceLabel || new Intl.NumberFormat(client.locale || 'fr', {
                          style: 'currency',
                          currency: client.currency || 'XOF',
                          maximumFractionDigits: 0
                        }).format(product.price)}
                      </strong>
                    </span>
                    <div class="productShowcaseCard__actions">
                      {product.price > 0 && (
                        <button
                          type="button"
                          class="productShowcaseCard__cartBtn addCartTrigger"
                          data-slug={product.slug}
                          data-name={product.name}
                          data-price={product.price}
                        >
                          + Panier
                        </button>
                      )}
                      <a
                        href={`https://wa.me/${whatsappClean}?text=${encodeURIComponent('Bonjour, je souhaite connaître la disponibilité et le prix pour : ' + product.name)}`}
                        target="_blank"
                        rel="noopener"
                        class="productShowcaseCard__waBtn"
                      >
                        WhatsApp
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 7. GALERIE PHOTOS RÉELLES DE LA BOUTIQUE -->
    {client.brand.gallery && client.brand.gallery.length > 0 && (
      <section class="section" id="galerie">
        <div class="section__container">
          <div class="section__header">
            <span class="section__eyebrow">Au cœur du Super U Deux Plateaux</span>
            <h2 class="section__title">Découvrez Notre Espace en Images</h2>
            <p class="section__subtitle">
              Un emplacement accessible, climatisé et sécurisé dans la galerie commerciale de Sococé. Cliquez sur une photo pour l'agrandir.
            </p>
          </div>

          <div class="shopGalleryGrid">
            {client.brand.gallery.map((photo) => (
              <figure class="shopGalleryCard">
                <button
                  type="button"
                  class="shopGalleryCard__zoomBtn galleryZoomTrigger"
                  data-src={photo.src}
                  data-alt={photo.alt}
                  data-caption={photo.caption || photo.alt}
                  aria-label={`Agrandir la photo : ${photo.alt}`}
                >
                  <img src={photo.src} alt={photo.alt} width="540" height="360" loading="lazy" />
                  <span class="shopGalleryCard__zoomHint">🔍 Agrandir</span>
                </button>
                {photo.caption && (
                  <figcaption class="shopGalleryCard__caption">{photo.caption}</figcaption>
                )}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 8. FAQ / ACCORDION SECTION -->
    <section class="section --subtle" id="faq">
      <div class="section__container --narrow">
        <div class="section__header">
          <span class="section__eyebrow">Vos Questions, Nos Réponses</span>
          <h2 class="section__title">Questions Fréquentes</h2>
          <p class="section__subtitle">Tout savoir sur le Studio Photo Maria, nos réparations, nos cachets express et notre boutique.</p>
        </div>

        <Accordion items={faqs} modifier="chrome" />
      </div>
    </section>
  </main>

  <!-- Modale accessible (Dialog) pour le pattern lien-modale des prestations -->
  <dialog id="serviceModal" class="serviceModal" closedby="any" aria-labelledby="modalTitle">
    <article class="serviceModal__box">
      <button type="button" id="modalCloseBtn" class="serviceModal__close" aria-label="Fermer la boîte de dialogue">✕</button>
      <span id="modalCategory" class="serviceModal__category"></span>
      <h3 id="modalTitle" class="serviceModal__title"></h3>
      <p id="modalPrice" class="serviceModal__price"></p>
      <p id="modalDesc" class="serviceModal__desc"></p>
      <ul id="modalHighlights" class="serviceModal__highlights"></ul>
      <div class="serviceModal__actions">
        <a id="modalWaBtn" href="#" class="btn --primary" target="_blank" rel="noopener">
          Demander un prix / Réserver sur WhatsApp
        </a>
        <button type="button" id="modalWaveBtn" class="btn --wave openWaveModalTrigger">
          Payer avec Wave QR
        </button>
        <a id="modalFullLink" href="#" class="btn --secondary">Fiche complète</a>
      </div>
    </article>
  </dialog>

  <!-- Modale Lightbox pour agrandir les photos de la boutique -->
  <dialog id="galleryModal" class="galleryModal" closedby="any" aria-label="Aperçu photo agrandi">
    <figure class="galleryModal__box">
      <button type="button" id="galleryCloseBtn" class="galleryModal__close" aria-label="Fermer l'aperçu photo">✕</button>
      <img id="galleryModalImg" src="" alt="" />
      <figcaption id="galleryModalCaption"></figcaption>
    </figure>
  </dialog>

  <WaveModal />
  <CartDrawer />
  <Footer />
  <FabContact />
  <FabTools />
</Layout>

<script>
  import { updateStorage } from '@/lib/storage';

  // 1. Filtrage par onglets des 5 pôles de prestations
  const tabBtns = document.querySelectorAll('.categoryTabs__btn');
  const serviceCards = document.querySelectorAll('#servicesGridContainer .serviceCard');

  function filterServices(category: string) {
    tabBtns.forEach((btn) => {
      const isMatch = (btn as HTMLElement).dataset.filter === category;
      btn.classList.toggle('--active', isMatch);
      btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
    });

    serviceCards.forEach((card) => {
      const cardEl = card as HTMLElement;
      const cardCat = cardEl.dataset.category || '';
      if (category === 'all' || cardCat === category) {
        cardEl.style.display = 'flex';
      } else {
        cardEl.style.display = 'none';
      }
    });
  }

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = (btn as HTMLElement).dataset.filter || 'all';
      filterServices(cat);
    });
  });

  // Liens rapides du Hero qui activent directement le bon filtre de pôle
  document.querySelectorAll('[data-filter-jump]').forEach((link) => {
    link.addEventListener('click', () => {
      const targetCat = (link as HTMLElement).dataset.filterJump;
      if (targetCat) {
        filterServices(targetCat);
      }
    });
  });

  // 2. Pattern Lien-Modale pour les prestations
  const modal = document.getElementById('serviceModal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('modalCloseBtn');
  const categoryEl = document.getElementById('modalCategory');
  const titleEl = document.getElementById('modalTitle');
  const priceEl = document.getElementById('modalPrice');
  const descEl = document.getElementById('modalDesc');
  const highlightsEl = document.getElementById('modalHighlights');
  const waBtn = document.getElementById('modalWaBtn') as HTMLAnchorElement | null;
  const fullLink = document.getElementById('modalFullLink') as HTMLAnchorElement | null;

  document.querySelectorAll('.modalTrigger').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      if (modal && typeof modal.showModal === 'function') {
        e.preventDefault();
        const target = e.currentTarget as HTMLElement;
        const slug = target.dataset.slug || '';
        const title = target.dataset.title || '';
        const category = target.dataset.category || '';
        const price = target.dataset.price || '';
        const desc = target.dataset.desc || '';
        let highlights: string[] = [];
        try {
          highlights = JSON.parse(target.dataset.highlights || '[]');
        } catch {
          highlights = [];
        }

        if (categoryEl) categoryEl.textContent = category;
        if (titleEl) titleEl.textContent = title;
        if (priceEl) priceEl.textContent = price;
        if (descEl) descEl.textContent = desc;
        if (highlightsEl) {
          highlightsEl.innerHTML = highlights.map((h) => `<li>✦ ${h}</li>`).join('');
          highlightsEl.style.display = highlights.length > 0 ? 'flex' : 'none';
        }
        if (fullLink) fullLink.href = `/prestations/${slug}`;
        if (waBtn) {
          waBtn.href = `https://wa.me/2250544263245?text=${encodeURIComponent('Bonjour Business Center Prestige Services, je souhaite un tarif / réserver : ' + title)}`;
        }

        modal.showModal();
        window.history.pushState({ modalOpen: true, slug }, '', `/prestations/${slug}`);
      }
    });
  });

  closeBtn?.addEventListener('click', () => {
    modal?.close();
  });

  modal?.addEventListener('close', () => {
    if (window.location.pathname.startsWith('/prestations/')) {
      window.history.pushState(null, '', '/');
    }
  });

  // Fallback light-dismiss pour serviceModal
  if (modal && !('closedBy' in HTMLDialogElement.prototype)) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  }

  // 3. Lightbox Galerie Photos de la boutique
  const galleryModal = document.getElementById('galleryModal') as HTMLDialogElement | null;
  const galleryCloseBtn = document.getElementById('galleryCloseBtn');
  const galleryImg = document.getElementById('galleryModalImg') as HTMLImageElement | null;
  const galleryCaption = document.getElementById('galleryModalCaption');

  document.querySelectorAll('.galleryZoomTrigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      if (galleryImg) {
        galleryImg.src = el.dataset.src || '';
        galleryImg.alt = el.dataset.alt || '';
      }
      if (galleryCaption) {
        galleryCaption.textContent = el.dataset.caption || '';
      }
      galleryModal?.showModal();
    });
  });

  galleryCloseBtn?.addEventListener('click', () => {
    galleryModal?.close();
  });

  if (galleryModal && !('closedBy' in HTMLDialogElement.prototype)) {
    galleryModal.addEventListener('click', (e) => {
      if (e.target === galleryModal) galleryModal.close();
    });
  }

  // 4. Gestion des clics "Ajouter au panier" éventuels
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.addCartTrigger') as HTMLElement | null;
    if (!target) return;
    const slug = target.dataset.slug;
    const name = target.dataset.name;
    const price = Number(target.dataset.price);
    if (!slug || !name) return;

    updateStorage(prev => {
      const existing = prev.cart.find(i => i.id === slug);
      if (existing) {
        existing.quantity += 1;
      } else {
        prev.cart.push({ id: slug, name, price, quantity: 1 });
      }
      return prev;
    });
