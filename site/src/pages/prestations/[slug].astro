---
import Layout from '../../layouts/Layout.astro';
import { client } from '../../lib/client';
import Header from '../../components/Header/Header.astro';
import Footer from '../../components/Footer/Footer.astro';
import FabContact from '../../components/FabContact/FabContact.astro';
import FabTools from '../../components/FabTools/FabTools.astro';
import CartDrawer from '../../components/Cart/CartDrawer.astro';
import WaveModal from '../../components/WaveModal/WaveModal.astro';

export function getStaticPaths() {
  return client.services.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
const hasNumericPrice = typeof service.price === 'number' && service.price > 0;
const formattedPrice = hasNumericPrice
  ? new Intl.NumberFormat(client.locale || 'fr', {
      style: 'currency',
      currency: client.currency || 'XOF',
      maximumFractionDigits: 0
    }).format(service.price)
  : (service.priceLabel || 'Sur devis gratuit WhatsApp');

const whatsappMessage = encodeURIComponent(
  `Bonjour ${client.name}, je souhaite avoir un tarif ou réserver la prestation "${service.name}".`
);
---

<Layout
  title={`${service.name} — ${client.name}`}
  description={`${service.name} chez ${client.name} (${client.contact.address.district}). ${service.description}`}
  image={service.image}
>
  <Header />

  <main class="serviceDetailPage">
    <div class="serviceDetailPage__container">
      <nav class="serviceDetailPage__breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a> &gt; <a href="/#prestations">Nos 5 Pôles</a> &gt; <strong>{service.name}</strong>
      </nav>

      <article class="serviceDetailCard">
        <span class="serviceDetailCard__category">{service.category}</span>
        <h1 class="serviceDetailCard__title">{service.name}</h1>
        <p class="serviceDetailCard__description">{service.description}</p>

        {service.highlights && service.highlights.length > 0 && (
          <ul class="serviceDetailCard__highlights">
            {service.highlights.map((pt: string) => (
              <li>
                <span class="serviceDetailCard__check" aria-hidden="true">✦</span>
                <span>{pt}</span>
              </li>
            ))}
          </ul>
        )}

        <div class="serviceDetailCard__meta">
          <div class="metaItem">
            <span class="metaItem__label">Tarif & Modalités</span>
            <span class="metaItem__value">{formattedPrice}</span>
          </div>
          {service.duration && (
            <div class="metaItem">
              <span class="metaItem__label">Durée estimée</span>
              <span class="metaItem__value">~{service.duration} minutes</span>
            </div>
          )}
          <div class="metaItem">
            <span class="metaItem__label">Lieu</span>
            <span class="metaItem__value">Galerie Super U Deux Plateaux (Sococé)</span>
          </div>
        </div>

        <div class="serviceDetailCard__actions">
          <a
            href={`https://wa.me/${client.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${whatsappMessage}`}
            class="bookBtn"
            target="_blank"
            rel="noopener"
          >
            Demander un prix / Réserver sur WhatsApp
          </a>

          {client.payments?.wave && (
            <button type="button" class="wavePayBtn openWaveModalTrigger">
              Payer par QR Code Wave
            </button>
          )}

          {hasNumericPrice && (client.tier >= 2 || client.modules.includes('panier')) && (
            <button
              type="button"
              id="detailAddCartBtn"
              class="cartBtn"
              data-slug={service.slug}
              data-name={service.name}
              data-price={service.price}
            >
              + Ajouter au panier
            </button>
          )}

          <a href="/#prestations" class="backBtn">← Retour aux prestations</a>
        </div>
      </article>
    </div>
  </main>

  <WaveModal />
  <CartDrawer />
  <Footer />
  <FabContact />
  <FabTools />
</Layout>

<script>
  import { updateStorage } from '@/lib/storage';

  const cartBtn = document.getElementById('detailAddCartBtn');
  cartBtn?.addEventListener('click', () => {
    const slug = cartBtn.dataset.slug;
    const name = cartBtn.dataset.name;
    const price = Number(cartBtn.dataset.price);

    if (!slug || !name) return;

    updateStorage(prev => {
      const existing = prev.cart.find(i => i.id === slug);
      if (existing) {
        existing.quantity += 1;
      } else {
        prev.cart.push({ id: slug, name, price, quantity: 1 });
      }
      return prev;
    });

    window.dispatchEvent(new CustomEvent('cart:open'));
  });
</script>

<style lang="scss">
  .serviceDetailPage {
    min-height: 70vh;
    padding: 3rem 1.25rem;
    background: var(--color-surface, #FAF8F5);

    &__container {
      max-width: 840px;
      margin: 0 auto;
    }

    &__breadcrumb {
      margin-bottom: 1.75rem;
      font-size: 0.9rem;
      color: #64748b;

      a {
        color: var(--color-primary, #0B192C);
        font-weight: 600;
        &:hover { text-decoration: underline; }
      }
    }
  }

  .serviceDetailCard {
    background: #ffffff;
    border: 1px solid rgba(11, 25, 44, 0.1);
    border-top: 4px solid var(--color-accent, #C59B27);
    border-radius: 18px;
    padding: 2.5rem;
    box-shadow: 0 15px 35px -10px rgba(11, 25, 44, 0.08);

    &__category {
      display: inline-block;
      padding: 0.3rem 0.8rem;
      border-radius: 9999px;
      background: rgba(197, 155, 39, 0.15);
      font-size: 0.82rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #8a680d;
      margin-bottom: 0.85rem;
    }

    &__title {
      font-size: clamp(1.75rem, 4vw, 2.35rem);
      margin: 0 0 1rem;
      color: var(--color-primary, #0B192C);
    }

    &__description {
      font-size: 1.1rem;
      color: #475569;
      line-height: 1.7;
      margin-bottom: 1.5rem;
    }

    &__highlights {
      list-style: none;
      padding: 1.25rem;
      margin: 0 0 1.75rem;
      background: #faf8f5;
      border-radius: 12px;
      border: 1px solid rgba(197, 155, 39, 0.25);
      display: flex;
      flex-direction: column;
      gap: 0.6rem;

      li {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        font-weight: 600;
        color: #1e293b;
      }
    }

    &__check {
      color: var(--color-accent, #C59B27);
    }

    &__meta {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1.25rem;
      background: #f8fafc;
      padding: 1.35rem;
      border-radius: 12px;
      margin-bottom: 2rem;
    }

    &__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
    }
  }

  .metaItem {
    display: flex;
    flex-direction: column;

    &__label {
      font-size: 0.8rem;
      color: #64748b;
      margin-bottom: 0.25rem;
    }

    &__value {
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--color-primary, #0B192C);
    }
  }

  .bookBtn {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.5rem;
    background: #25D366;
    color: white;
    font-weight: 700;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 150ms;

    &:hover {
      transform: translateY(-2px);
    }
  }

  .wavePayBtn {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.35rem;
    background: #1898e8;
    color: #ffffff;
    font-weight: 700;
    border-radius: 10px;
    cursor: pointer;
    transition: transform 150ms;

    &:hover {
      transform: translateY(-2px);
    }
  }

  .backBtn {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.35rem;
    background: #f1f5f9;
    color: #334155;
    font-weight: 700;
    border-radius: 10px;
    text-decoration: none;

    &:hover {
      background: #e2e8f0;
    }
  }

  .cartBtn {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.5rem;
    background: var(--color-primary, #0B192C);
    color: white;
    font-weight: 700;
    border-radius: 10px;
    cursor: pointer;
  }
</style>
