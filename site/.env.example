# URLs & Routing
PUBLIC_SITE_URL=https://monsite.com
PUBLIC_BASE_PATH=/
PUBLIC_API_URL=http://localhost:3000

# Client ID & Context
PUBLIC_CLIENT_SLUG=nom-du-commerce

# Auth (Clerk)
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Médias (Cloudinary)
PUBLIC_CLOUDINARY_CLOUD_NAME=mon-cloud

# Analytics (Plausible auto-hébergé)
PUBLIC_PLAUSIBLE_DOMAIN=monsite.com
PUBLIC_PLAUSIBLE_HOST=https://stats.monagence.com

# Simulateur de rôles (afficher le bouton/sélecteur en bas à gauche)
PUBLIC_ROLE_SIMULATOR=true
