PORT=3000
NODE_ENV=development

# Base de données MongoDB Atlas (M0)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nom-du-commerce

# Authentification Clerk
CLERK_SECRET_KEY=sk_test_...

# Upload médias Cloudinary
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=abcdefg...

# Paiements
WAVE_API_KEY=wave_ci_test_...
WAVE_WEBHOOK_SECRET=wave_whsec_...
PAYDUNYA_MASTER_KEY=...
PAYDUNYA_PRIVATE_KEY=...
PAYDUNYA_TOKEN=...
PAYDUNYA_MODE=test

# Analytics Plausible (Proxy admin)
PLAUSIBLE_API_KEY=...

# Déclenchement de rebuild statique GitHub (Optionnel)
GITHUB_DISPATCH_TOKEN=ghp_...
GITHUB_REPO=mon-orga/mon-repo

# Simulateur de rôles (l'API accepte X-Simulated-Role et route vers demo_<slug>)
ROLE_SIMULATOR=true

# Sécurité CORS
ALLOWED_ORIGINS=http://localhost:4321,https://monsite.com
